    img->setAlignment(Qt::AlignCenter);
    img->setStyleSheet("background-color:#111;");
    if (!thumb.isNull()) {
        img->setPixmap(QPixmap::fromImage(thumb).scaled(img->size(), Qt::KeepAspectRatio, Qt::SmoothTransformation));
