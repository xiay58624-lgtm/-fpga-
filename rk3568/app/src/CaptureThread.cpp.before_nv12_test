class AsyncPlateWorker {
public:
    AsyncPlateWorker() {
        m_thread = std::thread([this]() { workerLoop(); });
    }

    ~AsyncPlateWorker() { stop(); }

    bool trySubmit(const cv::Mat &frame, quint64 displayConfigVersion,
                   bool nativeMosaic, unsigned int sourceMask,
                   quint64 sourceFrameSequence) {
        std::lock_guard<std::mutex> lock(m_mutex);
        if (!latest_frame::canAcceptTask(m_stopped, m_busy, m_hasJob)) {
            ++m_droppedTasks;
            return false;
        }
        m_job.frame = frame.clone();
        if (m_job.frame.empty()) {
            ++m_droppedTasks;
            return false;
        }
        m_job.displayConfigVersion = displayConfigVersion;
        m_job.nativeMosaic = nativeMosaic;
        m_job.sourceMask = sourceMask;
        m_job.sourceFrameSequence = sourceFrameSequence;
        m_job.sourceFrameAt = std::chrono::steady_clock::now();
        m_hasJob = true;
        m_busy = true;
        m_condition.notify_one();
        return true;
    }

    bool latest(quint64 displayConfigVersion, double configuredMaxAgeMs,
                AsyncPlateResult &result, double &resultAgeMs,
                double &effectiveMaxAgeMs) const {
        std::lock_guard<std::mutex> lock(m_mutex);
        const bool hasResult = m_result.valid || !m_result.error.isEmpty();
        if (!hasResult ||
            m_result.displayConfigVersion != displayConfigVersion) {
            return false;
        }
        resultAgeMs = elapsedMs(m_result.sourceFrameAt,
                                std::chrono::steady_clock::now());
        effectiveMaxAgeMs = plate_display::effectiveOverlayMaxAgeMs(
            configuredMaxAgeMs, m_result.workerMs);
        if (!latest_frame::resultUsable(
                true, m_result.displayConfigVersion, displayConfigVersion,
                resultAgeMs, effectiveMaxAgeMs)) {
            return false;
        }
        result = m_result;
        return true;
    }

    void invalidateResult() {
        std::lock_guard<std::mutex> lock(m_mutex);
        m_result = AsyncPlateResult{};
    }

    bool busy() const {
        std::lock_guard<std::mutex> lock(m_mutex);
        return m_busy || m_hasJob;
    }

    void waitUntilIdle(const std::atomic_bool &stopRequested) {
        std::unique_lock<std::mutex> lock(m_mutex);
        while ((m_busy || m_hasJob) && !m_stopped &&
               !stopRequested.load(std::memory_order_relaxed)) {
            m_condition.wait_for(lock, std::chrono::milliseconds(10));
        }
    }

    quint64 droppedTasks() const {
        std::lock_guard<std::mutex> lock(m_mutex);
        return m_droppedTasks;
    }

    void completionTotals(quint64 &cycles, quint64 &tasks) const {
        std::lock_guard<std::mutex> lock(m_mutex);
        cycles = m_completedCycles;
        tasks = m_completedTasks;
    }

    void stop() {
        {
            std::lock_guard<std::mutex> lock(m_mutex);
            if (m_stopped) {
                if (!m_thread.joinable()) return;
            }
            m_stopped = true;
            m_hasJob = false;
            m_condition.notify_all();
        }
        if (m_thread.joinable()) m_thread.join();
    }

private:
    struct Job {
        cv::Mat frame;
        quint64 displayConfigVersion = 0;
        bool nativeMosaic = false;
        unsigned int sourceMask = kActiveSourceMask;
        quint64 sourceFrameSequence = 0;
        std::chrono::steady_clock::time_point sourceFrameAt;
    };

    void workerLoop() {
        quint64 appliedConfigVersion = 0;
        for (;;) {
            Job job;
            {
                std::unique_lock<std::mutex> lock(m_mutex);
                m_condition.wait(lock, [this]() {
                    return m_stopped || m_hasJob;
                });
                if (m_stopped) return;
                job = std::move(m_job);
                m_hasJob = false;
            }

            AsyncPlateResult result;
            result.displayConfigVersion = job.displayConfigVersion;
            result.sourceFrameAt = job.sourceFrameAt;
            const auto workerStart = std::chrono::steady_clock::now();
            try {
                if (appliedConfigVersion != job.displayConfigVersion) {
                    yolo_reset_temporal_state();
                    appliedConfigVersion = job.displayConfigVersion;
                }
                yolo_set_view_context(0, 1, 1, 2, 3, 4);
                yolo_set_native_mosaic_layout(
                    job.nativeMosaic, kSourceWidth, kSourceHeight,
                    job.sourceMask);
                yolo_set_source_frame_sequence(job.sourceFrameSequence);

                cv::Mat original = job.frame.clone();
                yolo_run(job.frame);
                yolo_set_native_mosaic_layout(false, kSourceWidth,
                                              kSourceHeight, kActiveSourceMask);

                yolo_get_last_stage_ms(&result.boxMs, &result.ocrMs);
                PlateDetectorRuntimeMetrics metrics;
                yolo_get_last_det_runtime_metrics(&metrics);
                result.executed = metrics.executed;
                result.pipelineEnabled = metrics.pipeline_enabled;
                result.pipelineActive = metrics.pipeline_active;
                result.quantizedOutput = metrics.quantized_output;
                result.taskCount = metrics.task_count;
                result.scoreCandidates = metrics.score_candidates;
                result.decodedCandidates = metrics.decoded_candidates;
                result.finalCandidates = metrics.final_candidates;
                result.configuredStride = metrics.configured_stride;
                result.sourceFrameSequence = metrics.source_frame_sequence;
                result.lastDetectionSourceSequence =
                    metrics.last_detection_source_sequence;
                result.preMs = metrics.pre_ms;
                result.npuWallMs = metrics.npu_wall_ms;
                result.npuHwMs = metrics.npu_hw_ms;
                result.postMs = metrics.post_ms;
                result.e2eMs = metrics.e2e_ms;
                result.overlapMs = metrics.overlap_saved_ms;
                result.strategy = QString::fromLatin1(metrics.strategy);
                result.preprocessBackend = QString::fromLatin1(
                    metrics.preprocess_backend);
                result.preprocessRequested = QString::fromLatin1(
                    metrics.preprocess_requested);
                result.preprocessFallback = QString::fromLatin1(
                    metrics.preprocess_fallback_reason);

                const auto overlayStart = std::chrono::steady_clock::now();
                std::vector<cv::Rect> overlayRegions;
                yolo_get_last_overlay_regions(overlayRegions);
                result.overlayPatches = buildOverlayPatches(
                    original, job.frame, overlayRegions);
                result.overlayMs = elapsedMs(overlayStart,
                                             std::chrono::steady_clock::now());
                static bool localOverlayLogged = false;
                if (!localOverlayLogged) {
                    size_t patchPixels = 0;
                    for (const OverlayPatch &patch : result.overlayPatches) {
                        patchPixels += static_cast<size_t>(patch.region.area());
                    }
                    qInfo().noquote() << QString(
                        "RK_CAPTURE overlay backend=local_patches "
                        "regions=%1 patches=%2 pixels=%3 frame_pixels=%4")
                        .arg(static_cast<qulonglong>(overlayRegions.size()))
                        .arg(static_cast<qulonglong>(
                            result.overlayPatches.size()))
                        .arg(static_cast<qulonglong>(patchPixels))
                        .arg(static_cast<qulonglong>(job.frame.total()));
                    localOverlayLogged = true;
                }
                result.valid = true;
            } catch (const std::exception &e) {
                yolo_set_native_mosaic_layout(false, kSourceWidth,
                                              kSourceHeight, kActiveSourceMask);
                result.error = QString::fromLocal8Bit(e.what());
            } catch (...) {
                yolo_set_native_mosaic_layout(false, kSourceWidth,
                                              kSourceHeight, kActiveSourceMask);
                result.error = QStringLiteral("unknown inference exception");
            }
            result.workerMs = elapsedMs(workerStart,
                                        std::chrono::steady_clock::now());

            {
                std::lock_guard<std::mutex> lock(m_mutex);
                if (result.executed) {
                    ++m_completedCycles;
                    m_completedTasks += static_cast<quint64>(
                        std::max(1, result.taskCount));
                }
                m_result = std::move(result);
                m_busy = false;
                m_condition.notify_all();
            }
        }
    }

    mutable std::mutex m_mutex;
    std::condition_variable m_condition;
    std::thread m_thread;
    Job m_job;
    AsyncPlateResult m_result;
    bool m_hasJob = false;
    bool m_busy = false;
    bool m_stopped = false;
    quint64 m_droppedTasks = 0;
    quint64 m_completedCycles = 0;
    quint64 m_completedTasks = 0;
};

struct AsyncEnvResult {
    std::vector<OverlayPatch> overlayPatches;
    std::vector<GenericYoloDetection> detections;
    quint64 sourceFrameSequence = 0;
    std::chrono::steady_clock::time_point sourceFrameAt;
    bool valid = false;
    double workerMs = 0.0;
    QString error;
};

// Environment inference must not hold up the PCIe/display loop. Keep one
// running job and one replaceable pending job so a slow NPU run never creates
// a backlog of stale frames.
class AsyncEnvWorker {
public:
    AsyncEnvWorker() : m_thread([this]() { workerLoop(); }) {}
    ~AsyncEnvWorker() { stop(); }

    bool trySubmit(const cv::Mat &frame, bool splitMosaic,
                   quint64 sourceFrameSequence) {
        if (frame.empty()) return false;
        std::lock_guard<std::mutex> lock(m_mutex);
        if (m_stopped) return false;
        if (m_hasJob) ++m_droppedTasks;
        m_job.frame = frame.clone();
        if (m_job.frame.empty()) return false;
        m_job.splitMosaic = splitMosaic;
        m_job.sourceFrameSequence = sourceFrameSequence;
        m_job.sourceFrameAt = std::chrono::steady_clock::now();
        m_hasJob = true;
        m_condition.notify_one();
        return true;
    }

    bool latest(double maxAgeMs, AsyncEnvResult &result,
                double &resultAgeMs) const {
        std::lock_guard<std::mutex> lock(m_mutex);
        if (!m_result.valid) return false;
        resultAgeMs = elapsedMs(m_result.sourceFrameAt,
                                std::chrono::steady_clock::now());
        if (maxAgeMs > 0.0 && resultAgeMs > maxAgeMs) return false;
        result = m_result;
        return true;
    }

    quint64 droppedTasks() const {
        std::lock_guard<std::mutex> lock(m_mutex);
        return m_droppedTasks;
    }

    void stop() {
        {
            std::lock_guard<std::mutex> lock(m_mutex);
            if (m_stopped) {
                if (!m_thread.joinable()) return;
            }
            m_stopped = true;
            m_hasJob = false;
            m_condition.notify_all();
        }
        if (m_thread.joinable()) m_thread.join();
    }

private:
    struct Job {
        cv::Mat frame;
        bool splitMosaic = false;
        quint64 sourceFrameSequence = 0;
        std::chrono::steady_clock::time_point sourceFrameAt;
    };

    void workerLoop() {
        for (;;) {
            Job job;
            {
                std::unique_lock<std::mutex> lock(m_mutex);
                m_condition.wait(lock, [this]() {
                    return m_stopped || m_hasJob;
                });
                if (m_stopped) return;
                job = std::move(m_job);
                m_hasJob = false;
            }

            AsyncEnvResult result;
            result.sourceFrameAt = job.sourceFrameAt;
            const auto workerStart = std::chrono::steady_clock::now();
            try {
                cv::Mat original = job.frame.clone();
                generic_yolo_set_frame_sequence(job.sourceFrameSequence);
                generic_yolo_run(job.frame, job.splitMosaic);
                std::uint64_t detectionSequence = 0;
                generic_yolo_get_last_detections(result.detections,
                                                 detectionSequence);
                result.sourceFrameSequence = static_cast<quint64>(detectionSequence);
                std::vector<cv::Rect> regions;
                // generic_yolo_run draws directly on the working copy. Capture
                // only changed regions so the newest camera frame remains the
                // display base when the result becomes available.
                regions.emplace_back(0, 0, job.frame.cols, job.frame.rows);
                result.overlayPatches = buildOverlayPatches(
                    original, job.frame, regions);
                result.valid = true;
            } catch (const std::exception &e) {
                result.error = QString::fromLocal8Bit(e.what());
            } catch (...) {
                result.error = QStringLiteral("unknown environment inference exception");
            }
            result.workerMs = elapsedMs(workerStart,
                                        std::chrono::steady_clock::now());
            {
                std::lock_guard<std::mutex> lock(m_mutex);
                m_result = std::move(result);
                m_condition.notify_all();
            }
        }
    }

    mutable std::mutex m_mutex;
    std::condition_variable m_condition;
    std::thread m_thread;
    Job m_job;
    AsyncEnvResult m_result;
    bool m_hasJob = false;
    bool m_stopped = false;
    quint64 m_droppedTasks = 0;
};

