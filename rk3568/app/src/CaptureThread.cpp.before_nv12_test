// The installed V1 driver reads the FPGA's half-sampled 2x2 mosaic.  The
// complete DMA frame is 1280x720 RGB565 and each physical source is 640x360.
constexpr int kMosaicWidth = 1280;
constexpr int kMosaicHeight = 720;
constexpr int kSourceWidth = 640;
constexpr int kSourceHeight = 360;
constexpr int kPreviewWidth = 1280;
constexpr int kPreviewHeight = 720;
constexpr int kRgb565BytesPerPixel = 2;
constexpr int kMosaicStrideBytes = kMosaicWidth * kRgb565BytesPerPixel;
constexpr int kMosaicFrameBytes = kMosaicStrideBytes * kMosaicHeight;
constexpr int kPcieRingCount = 3;
constexpr double kDefaultV1TargetFps = 30.0;
// The current FPGA/RK3568 capture contract exposes four source lanes in the
// 2x2 mosaic.
constexpr unsigned int kActiveSourceMask = 0x0Fu;

static int configuredPlateInferStride() {
    int stride = 1;
    if (const char *value = std::getenv("RK3568_PLATE_INFER_STRIDE")) {
        const int parsed = std::atoi(value);
        if (parsed >= 1 && parsed <= 60) stride = parsed;
    }
    return stride;
}

struct SdMediaState {
    enum class Kind {
        Invalid = 0,
        Image = 1,
        Video = 2,
        Folder = 3,
        FolderQuad = 4
    };

    Kind kind = Kind::Invalid;
    cv::Mat stillImage;
    cv::VideoCapture video;
    std::vector<QString> imagePaths;
    std::array<std::vector<QString>, 4> quadImagePaths;
    int imageIndex = 0;
    std::array<int, 4> quadImageIndex{0, 0, 0, 0};
    double intervalMs = 200.0;
};

static bool isImageSuffix(const QString &suffix) {
    const QString s = suffix.trimmed().toLower();
    return s == "jpg" || s == "jpeg" || s == "png" || s == "bmp" || s == "webp";
}

static bool isVideoSuffix(const QString &suffix) {
    const QString s = suffix.trimmed().toLower();
    return s == "mp4" || s == "avi" || s == "mov" || s == "mkv" || s == "ts" || s == "m4v";
}

static QByteArray nativePathBytes(const QString &path) {
    return QFile::encodeName(path);
}

static cv::Mat loadBgrImage(const QString &path) {
    QImageReader reader(path);
    reader.setAutoTransform(true);
    QImage image = reader.read();
    if (image.isNull()) return cv::Mat();
    QImage rgb = image.convertToFormat(QImage::Format_RGB888);
    cv::Mat rgbMat(rgb.height(), rgb.width(), CV_8UC3, (void*)rgb.constBits(), rgb.bytesPerLine());
    cv::Mat bgr;
    cv::cvtColor(rgbMat, bgr, cv::COLOR_RGB2BGR);
    return bgr.clone();
}

static std::vector<QString> collectImagesFromDir(const QString &path, bool recursive) {
    std::vector<QString> out;
    QDirIterator it(path, QDir::Files, recursive ? QDirIterator::Subdirectories : QDirIterator::NoIteratorFlags);
    while (it.hasNext()) {
        const QString p = it.next();
        if (isImageSuffix(QFileInfo(p).suffix())) out.push_back(p);
    }
    std::sort(out.begin(), out.end());
    return out;
}

static bool tryPrepareQuadFolders(const QString &path, SdMediaState &state) {
    const QStringList names1 = {"1", "2", "3", "4"};
    const QStringList names1b = {"01", "02", "03", "04"};
    const QStringList names2 = {"src1", "src2", "src3", "src4"};
    const QStringList names3 = {"source1", "source2", "source3", "source4"};
    const QStringList names4 = {"cam1", "cam2", "cam3", "cam4"};
    const QStringList names5 = {QString::fromUtf8("源1"), QString::fromUtf8("源2"), QString::fromUtf8("源3"), QString::fromUtf8("源4")};
    const QList<QStringList> groups = {names1, names1b, names2, names3, names4, names5};
    for (const QStringList &names : groups) {
        bool ok = true;
        std::array<std::vector<QString>, 4> lanes;
        for (int i = 0; i < 4; ++i) {
            const QString sub = QDir(path).filePath(names[i]);
            QFileInfo fi(sub);
            if (!fi.exists() || !fi.isDir()) {
                ok = false;
                break;
            }
            lanes[i] = collectImagesFromDir(sub, true);
            if (lanes[i].empty()) {
                ok = false;
                break;
            }
        }
        if (ok) {
            state.quadImagePaths = std::move(lanes);
            state.quadImageIndex = {0, 0, 0, 0};
            state.kind = SdMediaState::Kind::FolderQuad;
            state.intervalMs = 1000.0;
            return true;
        }
    }

    return false;
}

static bool prepareSdMedia(const QString &path, SdMediaState &state, QString &error) {
    QFileInfo fi(path);
    if (!fi.exists()) {
        error = QString("SD卡输入不存在: %1").arg(path);
        return false;
    }

    if (fi.isDir()) {
        if (tryPrepareQuadFolders(path, state)) {
            return true;
        }

        state.imagePaths = collectImagesFromDir(path, true);
        if (state.imagePaths.empty()) {
            error = QString("文件夹中未找到图片: %1").arg(path);
            return false;
        }
        // A normal directory is a sequential image source, regardless of its
        // image count.  Four-way input is opt-in through four named
        // subdirectories (handled by tryPrepareQuadFolders above); otherwise
        // silently shrinking every image into a 640x360 quadrant destroys the
        // small-plate detail that the sliding detector is meant to recover.
        state.kind = SdMediaState::Kind::Folder;
        state.intervalMs = 1000.0;
        return true;
    }

    const QString suffix = fi.suffix();
    if (isImageSuffix(suffix)) {
        state.stillImage = loadBgrImage(path);
        if (state.stillImage.empty()) {
            error = QString("图片读取失败: %1").arg(path);
            return false;
        }
        state.kind = SdMediaState::Kind::Image;
        state.intervalMs = 1000.0;
        return true;
    }

    if (isVideoSuffix(suffix)) {
        const QByteArray bytes = nativePathBytes(path);
        if (!state.video.open(bytes.constData())) {
            error = QString("视频打开失败: %1").arg(path);
            return false;
        }
        double fps = state.video.get(cv::CAP_PROP_FPS);
        if (!(fps > 0.0 && fps <= 120.0)) fps = 25.0;
        state.kind = SdMediaState::Kind::Video;
        state.intervalMs = 1000.0 / fps;
        return true;
    }

    error = QString("暂不支持的SD卡文件类型: %1").arg(path);
    return false;
}

static bool nextSdFrame(SdMediaState &state, cv::Mat &frame, bool &waitOnly) {
    waitOnly = false;
    frame.release();
    if (state.kind == SdMediaState::Kind::Image) {
        if (state.stillImage.empty()) return false;
        if (state.imageIndex > 0) {
            waitOnly = true;
            return true;
        }
        frame = state.stillImage.clone();
        state.imageIndex = 1;
        return !frame.empty();
    }

    if (state.kind == SdMediaState::Kind::Folder) {
        const int total = (int)state.imagePaths.size();
        for (int tries = 0; tries < total; ++tries) {
            const QString p = state.imagePaths[(state.imageIndex++) % total];
            frame = loadBgrImage(p);
            if (!frame.empty()) return true;
        }
        return false;
    }

    if (state.kind == SdMediaState::Kind::Video) {
        if (!state.video.isOpened()) return false;
        if (state.video.read(frame) && !frame.empty()) return true;
        state.video.set(cv::CAP_PROP_POS_FRAMES, 0.0);
        return state.video.read(frame) && !frame.empty();
    }

    return false;
}

static void fitFrameToRect(const cv::Mat &srcIn, cv::Mat &canvas) {
    canvas.setTo(cv::Scalar(0, 0, 0));
    if (srcIn.empty()) return;

    cv::Mat src = srcIn;
    cv::Mat converted;
    if (src.channels() == 1) {
        cv::cvtColor(src, converted, cv::COLOR_GRAY2BGR);
        src = converted;
    } else if (src.channels() == 4) {
        cv::cvtColor(src, converted, cv::COLOR_BGRA2BGR);
        src = converted;
    }

    const double sx = (double)canvas.cols / (double)src.cols;
    const double sy = (double)canvas.rows / (double)src.rows;
    const double scale = std::min(sx, sy);
    int w = std::max(1, (int)std::llround(src.cols * scale));
    int h = std::max(1, (int)std::llround(src.rows * scale));
    int x = (canvas.cols - w) / 2;
    int y = (canvas.rows - h) / 2;
    if (x < 0 || y < 0 || x + w > canvas.cols || y + h > canvas.rows) return;
    cv::Mat roi = canvas(cv::Rect(x, y, w, h));
    cv::resize(src, roi, roi.size(), 0, 0, cv::INTER_LINEAR);
}

static void fitFrameToCanvas(const cv::Mat &srcIn, uint8_t *dstBuf) {
    cv::Mat canvas(kPreviewHeight, kPreviewWidth, CV_8UC3, dstBuf);
    fitFrameToRect(srcIn, canvas);
}

static inline cv::Rect quadRect(int quadIndex, int w, int h) {
    int halfW = w / 2;
    int halfH = h / 2;
    switch (quadIndex) {
        case 0: return cv::Rect(0, 0, halfW, halfH);
        case 1: return cv::Rect(halfW, 0, w - halfW, halfH);
        case 2: return cv::Rect(0, halfH, halfW, h - halfH);
        default: return cv::Rect(halfW, halfH, w - halfW, h - halfH);
    }
}

static inline cv::Mat sourceRoi(cv::Mat& fpgaMosaic, int sourceIndex) {
    int idx = sourceIndex - 1;
    idx = std::max(0, std::min(3, idx));
    return fpgaMosaic(quadRect(idx, fpgaMosaic.cols, fpgaMosaic.rows));
}

#ifdef RK3568_HAVE_RGA
static bool rgaResizeBgr(const cv::Mat &src, cv::Mat &dst) {
    if (src.empty() || dst.empty() || src.type() != CV_8UC3 ||
        dst.type() != CV_8UC3 || src.step % src.elemSize() != 0 ||
        dst.step % dst.elemSize() != 0) {
        return false;
    }
    const int srcStridePixels = static_cast<int>(src.step / src.elemSize());
    const int dstStridePixels = static_cast<int>(dst.step / dst.elemSize());
    rga_buffer_t srcBuffer = wrapbuffer_virtualaddr(
        const_cast<unsigned char *>(src.data), src.cols, src.rows,
        RK_FORMAT_BGR_888, srcStridePixels, src.rows);
    rga_buffer_t dstBuffer = wrapbuffer_virtualaddr(
        dst.data, dst.cols, dst.rows, RK_FORMAT_BGR_888,
        dstStridePixels, dst.rows);
    return imresize(srcBuffer, dstBuffer) == IM_STATUS_SUCCESS;
}

static bool rgaRgb565ToBgr(const uint8_t *src, cv::Mat &dst,
                           bool rgb888Destination) {
    if (!src || dst.empty() || dst.type() != CV_8UC3 ||
        dst.step % dst.elemSize() != 0) {
        return false;
    }
    const int dstStridePixels = static_cast<int>(dst.step / dst.elemSize());
    rga_buffer_t srcBuffer = wrapbuffer_virtualaddr(
        const_cast<uint8_t *>(src), dst.cols, dst.rows,
        RK_FORMAT_RGB_565, dst.cols, dst.rows);
    const int dstFormat = rgb888Destination
        ? RK_FORMAT_RGB_888 : RK_FORMAT_BGR_888;
    rga_buffer_t dstBuffer = wrapbuffer_virtualaddr(
        dst.data, dst.cols, dst.rows, dstFormat,
        dstStridePixels, dst.rows);
    return imcvtcolor(srcBuffer, dstBuffer,
                      RK_FORMAT_RGB_565, dstFormat) ==
           IM_STATUS_SUCCESS;
}

static bool rgaBgrToRgb(const cv::Mat &src, QImage &dst) {
    if (src.empty() || src.type() != CV_8UC3 || dst.isNull() ||
        dst.format() != QImage::Format_RGB888 ||
        dst.width() != src.cols || dst.height() != src.rows ||
        src.step % src.elemSize() != 0 || dst.bytesPerLine() % 3 != 0) {
        return false;
    }
    const int srcStridePixels = static_cast<int>(src.step / src.elemSize());
    const int dstStridePixels = dst.bytesPerLine() / 3;
    rga_buffer_t srcBuffer = wrapbuffer_virtualaddr(
        const_cast<unsigned char *>(src.data), src.cols, src.rows,
        RK_FORMAT_BGR_888, srcStridePixels, src.rows);
    rga_buffer_t dstBuffer = wrapbuffer_virtualaddr(
        dst.bits(), dst.width(), dst.height(), RK_FORMAT_RGB_888,
        dstStridePixels, dst.height());
    return imcvtcolor(srcBuffer, dstBuffer,
                      RK_FORMAT_BGR_888, RK_FORMAT_RGB_888) ==
           IM_STATUS_SUCCESS;
}
#endif

static double rgb565BgrMeanError(const uint8_t *srcBytes,
                                 const cv::Mat &actual) {
    if (!srcBytes || actual.empty() || actual.type() != CV_8UC3 ||
        !actual.isContinuous()) {
        return std::numeric_limits<double>::infinity();
    }
    const auto *src = reinterpret_cast<const uint16_t *>(srcBytes);
    const int pixels = actual.cols * actual.rows;
    const int samples = std::min(4096, pixels);
    if (samples <= 0) return std::numeric_limits<double>::infinity();
    uint64_t totalError = 0;
    for (int sample = 0; sample < samples; ++sample) {
        const int index = static_cast<int>(
            (static_cast<int64_t>(sample) * pixels) / samples);
        const uint16_t value = src[index];
        const uint8_t expectedB = static_cast<uint8_t>((value & 0x1f) << 3);
        const uint8_t expectedG = static_cast<uint8_t>(((value >> 5) & 0x3f) << 2);
        const uint8_t expectedR = static_cast<uint8_t>(((value >> 11) & 0x1f) << 3);
        const uint8_t *pixel = actual.ptr<uint8_t>() + index * 3;
        totalError += static_cast<uint64_t>(std::abs(
            static_cast<int>(pixel[0]) - static_cast<int>(expectedB)));
        totalError += static_cast<uint64_t>(std::abs(
            static_cast<int>(pixel[1]) - static_cast<int>(expectedG)));
        totalError += static_cast<uint64_t>(std::abs(
            static_cast<int>(pixel[2]) - static_cast<int>(expectedR)));
    }
    return static_cast<double>(totalError) /
           static_cast<double>(samples * 3);
}

static double bgrRgbMeanError(const cv::Mat &src, const QImage &actual) {
    if (src.empty() || src.type() != CV_8UC3 || actual.isNull() ||
        actual.format() != QImage::Format_RGB888 ||
        actual.width() != src.cols || actual.height() != src.rows) {
        return std::numeric_limits<double>::infinity();
    }
    const int pixels = src.cols * src.rows;
    const int samples = std::min(4096, pixels);
    if (samples <= 0) return std::numeric_limits<double>::infinity();
    uint64_t totalError = 0;
    for (int sample = 0; sample < samples; ++sample) {
        const int index = static_cast<int>(
            (static_cast<int64_t>(sample) * pixels) / samples);
        const int y = index / src.cols;
        const int x = index - y * src.cols;
        const uint8_t *bgr = src.ptr<uint8_t>(y) + x * 3;
        const uint8_t *rgb = actual.constScanLine(y) + x * 3;
        totalError += static_cast<uint64_t>(std::abs(
            static_cast<int>(rgb[0]) - static_cast<int>(bgr[2])));
        totalError += static_cast<uint64_t>(std::abs(
            static_cast<int>(rgb[1]) - static_cast<int>(bgr[1])));
        totalError += static_cast<uint64_t>(std::abs(
            static_cast<int>(rgb[2]) - static_cast<int>(bgr[0])));
    }
    return static_cast<double>(totalError) /
           static_cast<double>(samples * 3);
}

static bool composeSdMosaic(SdMediaState &state, uint8_t *dstBuf,
                            std::array<cv::Mat, 4> *nativeFrames = nullptr) {
    if (state.kind != SdMediaState::Kind::FolderQuad) return false;
    if (nativeFrames) {
        for (cv::Mat &frame : *nativeFrames) frame.release();
    }
    cv::Mat canvas(kPreviewHeight, kPreviewWidth, CV_8UC3, dstBuf);
    canvas.setTo(cv::Scalar(0, 0, 0));
    bool anyOk = false;
    for (int lane = 0; lane < 4; ++lane) {
        auto &paths = state.quadImagePaths[(size_t)lane];
        if (paths.empty()) continue;
        cv::Mat frame;
        const int total = (int)paths.size();
        for (int tries = 0; tries < total; ++tries) {
            const QString p = paths[(size_t)(state.quadImageIndex[(size_t)lane]++ % total)];
            frame = loadBgrImage(p);
            if (!frame.empty()) break;
        }
        if (frame.empty()) continue;
        anyOk = true;
        if (nativeFrames) (*nativeFrames)[static_cast<size_t>(lane)] = frame;
        cv::Mat quad = canvas(quadRect(lane, canvas.cols, canvas.rows));
        fitFrameToRect(frame, quad);
    }
    return anyOk;
}

static void composeAnnotatedSdDisplay(
        const std::array<cv::Mat, 4> &nativeFrames,
        CaptureThread::DisplayMode mode,
        int singleSource,
        const std::array<int, 4> &mosaicMapping,
        uint8_t *dstBuf) {
    cv::Mat canvas(kPreviewHeight, kPreviewWidth, CV_8UC3, dstBuf);
    canvas.setTo(cv::Scalar(0, 0, 0));

    if (mode == CaptureThread::DisplayMode::SingleSource) {
        const int lane = std::max(0, std::min(3, singleSource - 1));
        fitFrameToRect(nativeFrames[static_cast<size_t>(lane)], canvas);
        return;
    }

    for (int quadrant = 0; quadrant < 4; ++quadrant) {
        int source = mode == CaptureThread::DisplayMode::FpgaMosaic
            ? quadrant + 1
            : mosaicMapping[static_cast<size_t>(quadrant)];
        if (source < 1 || source > 4) continue;
        cv::Mat dst = canvas(quadRect(quadrant, canvas.cols, canvas.rows));
        fitFrameToRect(nativeFrames[static_cast<size_t>(source - 1)], dst);
    }
}

static void composePciePreview(
        cv::Mat &nativeMosaic,
        CaptureThread::DisplayMode mode,
        int singleSource,
        const std::array<int, 4> &mosaicMapping,
        uint8_t *dstBuf,
        bool preferRga = false,
        bool *usedRga = nullptr) {
    if (usedRga) *usedRga = false;
    cv::Mat preview(kPreviewHeight, kPreviewWidth, CV_8UC3, dstBuf);
    if (nativeMosaic.empty()) {
        preview.setTo(cv::Scalar(0, 0, 0));
        return;
    }

    if (mode == CaptureThread::DisplayMode::FpgaMosaic) {
        if (nativeMosaic.size() == preview.size()) {
            nativeMosaic.copyTo(preview);
        } else {
#ifdef RK3568_HAVE_RGA
            if (preferRga && rgaResizeBgr(nativeMosaic, preview)) {
                if (usedRga) *usedRga = true;
                return;
            }
#endif
            cv::resize(nativeMosaic, preview, preview.size(), 0, 0,
                       cv::INTER_AREA);
        }
        return;
    }
    if (mode == CaptureThread::DisplayMode::SingleSource) {
        cv::Mat source = sourceRoi(nativeMosaic, singleSource);
#ifdef RK3568_HAVE_RGA
        if (preferRga && rgaResizeBgr(source, preview)) {
            if (usedRga) *usedRga = true;
            return;
        }
#endif
        fitFrameToRect(source, preview);
        return;
    }

    preview.setTo(cv::Scalar(0, 0, 0));
    for (int quadrant = 0; quadrant < 4; ++quadrant) {
        const int source = mosaicMapping[static_cast<size_t>(quadrant)];
        if (source < 1 || source > 4) continue;
        cv::Mat dst = preview(quadRect(quadrant, preview.cols, preview.rows));
        cv::Mat src = sourceRoi(nativeMosaic, source);
        if (src.size() == dst.size()) {
            src.copyTo(dst);
        } else {
#ifdef RK3568_HAVE_RGA
            if (preferRga && rgaResizeBgr(src, dst)) {
                if (usedRga) *usedRga = true;
                continue;
            }
#endif
            cv::resize(src, dst, dst.size(), 0, 0, cv::INTER_AREA);
        }
    }
}

