            lastDetDecodedCandidates = 0;
            lastDetFinalCandidates = 0;
            lastDetConfiguredStride = configuredPlateInferStride();
            lastDetSourceFrameSequence = 0;
            lastDetDetectionSourceSequence = 0;
            lastDetPreprocessBackend = QStringLiteral("disabled");
            lastDetPreprocessRequested = QStringLiteral("disabled");
            lastDetPreprocessFallback.clear();
            completedInferenceCycles = 0;
            completedInferenceTasks = 0;
            inferenceRateAccumSec = 0.0;
            publishedCycleFps = 0.0;
            publishedTaskFps = 0.0;
            publishedRateWindowSec = 0.0;
            inferenceRatePublished = false;
            if (plateWorker) {
                plateWorker->completionTotals(lastAsyncCompletedCycles,
                                              lastAsyncCompletedTasks);
            }
        }

        auto collectPlateRunMetrics = [&]() {
            if (!yolo_is_ready()) return;

            double boxMs = 0.0;
            double ocrMs = 0.0;
            yolo_get_last_stage_ms(&boxMs, &ocrMs);
            if ((boxMs + ocrMs) > 0.1) {
                plateStagesMeasured = true;
                plateStageBoxMs += boxMs;
                plateStageOcrMs += ocrMs;
            }

            double preMs = 0.0;
            double npuMs = 0.0;
            double postMs = 0.0;
            yolo_get_last_det_parts(&preMs, &npuMs, &postMs);
            PlateDetectorRuntimeMetrics runtimeMetrics;
            yolo_get_last_det_runtime_metrics(&runtimeMetrics);
            if (runtimeMetrics.executed) {
                syncDetectionCycleCompleted = true;
                syncDetectionTasksCompleted += static_cast<quint64>(
                    std::max(1, runtimeMetrics.task_count));
                plateDetRuntimeExecuted = true;
                plateDetPreMs += preMs;
                plateDetNpuMs += npuMs;
                plateDetNpuHwMs += runtimeMetrics.npu_hw_ms;
                plateDetPostMs += postMs;
                plateDetE2eMs += runtimeMetrics.e2e_ms;
                plateDetOverlapMs += runtimeMetrics.overlap_saved_ms;
                plateDetTaskCount += runtimeMetrics.task_count;
                lastDetScoreCandidates = runtimeMetrics.score_candidates;
                lastDetDecodedCandidates = runtimeMetrics.decoded_candidates;
                lastDetFinalCandidates = runtimeMetrics.final_candidates;
                lastDetConfiguredStride = runtimeMetrics.configured_stride;
                lastDetSourceFrameSequence =
                    runtimeMetrics.source_frame_sequence;
                lastDetDetectionSourceSequence =
                    runtimeMetrics.last_detection_source_sequence;
                plateDetPipelineEnabled = runtimeMetrics.pipeline_enabled;
                plateDetPipelineActive = plateDetPipelineActive ||
                    runtimeMetrics.pipeline_active;
                plateDetQuantizedOutput = runtimeMetrics.quantized_output;
                plateDetStrategy = QString::fromLatin1(runtimeMetrics.strategy);
                plateDetPreprocessBackend = QString::fromLatin1(
                    runtimeMetrics.preprocess_backend);
                plateDetPreprocessRequested = QString::fromLatin1(
                    runtimeMetrics.preprocess_requested);
                plateDetPreprocessFallback = QString::fromLatin1(
                    runtimeMetrics.preprocess_fallback_reason);
            }
        };

        auto runPlateFrame = [&](cv::Mat &plateFrame, int source, bool forceSingleSource) {
            const bool traceFirstInference = usePcie && !firstPlateInferenceStarted;
            const auto firstInferenceStart = tick();
            try {
                if (forceSingleSource) {
                    yolo_set_view_context((int)DisplayMode::SingleSource, source,
                                          source, source, source, source);
                }
                if (staticSdFrame) yolo_prepare_static_frame();
                if (usePcie) {
                    yolo_set_source_frame_sequence(pcieRxFrames);
                }
                if (traceFirstInference) {
                    firstPlateInferenceStarted = true;
                    qInfo().noquote() << QString(
                        "RK_CAPTURE V1 first inference starting frame=%1 source=%2 "
                        "strategy=%3 pipeline=%4")
                        .arg(pcieRxFrames).arg(source)
                        .arg(QString::fromLocal8Bit(
                            qgetenv("RK3568_PCIE_INFERENCE_STRATEGY")))
                        .arg(QString::fromLocal8Bit(qgetenv("RK3568_DET_PIPELINE")));
                    emit perfUpdate(QStringLiteral(
                        "PCIe V1 画面已显示，正在启动首次车牌推理..."));
                }
                yolo_run(plateFrame);
                if (traceFirstInference) {
                    qInfo().noquote() << QString(
                        "RK_CAPTURE V1 first inference completed ms=%1")
                        .arg(ms(firstInferenceStart, tick()), 0, 'f', 2);
                }
                collectPlateRunMetrics();
                return true;
            } catch (const std::exception& e) {
                if (traceFirstInference) {
                    qCritical().noquote() << QString(
                        "RK_CAPTURE V1 first inference failed ms=%1 error=%2")
                        .arg(ms(firstInferenceStart, tick()), 0, 'f', 2)
                        .arg(QString::fromLocal8Bit(e.what()));
                }
                static int inferErrWarn = 0;
                if ((inferErrWarn++ % 30) == 0) {
                    emit perfUpdate(QString("推理异常(车牌): %1").arg(QString::fromLocal8Bit(e.what())));
                }
                return false;
            }
        };

        if (!globalInferenceEnabled || algoMode == AlgoMode::EnvOnly ||
            startupPreviewOnly) {
            // skip
        } else if (asyncPciePlate) {
            static int asyncNoModelWarn = 0;
            bool strategyOk = false;
            const int requestedStrategy =
                qgetenv("RK3568_PCIE_INFERENCE_STRATEGY")
                    .trimmed().toInt(&strategyOk);
            const int pcieInferenceStrategy = strategyOk
                ? std::clamp(requestedStrategy, 0, 1) : 0;
            bool nativeMosaic = pcieInferenceStrategy == 1;
            unsigned int sourceMask = kActiveSourceMask;
            if (mode == DisplayMode::SingleSource) {
                nativeMosaic = true;
                sourceMask = 1u << static_cast<unsigned int>(singleSource - 1);
            } else if (mode == DisplayMode::CustomMosaic) {
                sourceMask = 0u;
                for (int source : mosaicMapping) {
                    if (source >= 1 && source <= 4) {
                        sourceMask |= 1u << static_cast<unsigned int>(source - 1);
                    }
                }
            }

            if (yolo_is_ready()) {
                const bool submitted = plateWorker->trySubmit(
                    fpgaMosaic, displayConfigVersion,
                    nativeMosaic, sourceMask, pcieRxFrames);
                if (submitted && !firstPlateInferenceStarted) {
                    firstPlateInferenceStarted = true;
                    qInfo().noquote() << QString(
                        "RK_CAPTURE V1 first async inference submitted frame=%1 "
                        "strategy=%2 sources=0x%3")
                        .arg(pcieRxFrames).arg(pcieInferenceStrategy)
                        .arg(sourceMask, 1, 16);
                }
            } else if ((asyncNoModelWarn++ % 30) == 0) {
                const char* dir = std::getenv("RK3568_MODEL_DIR");
                const QString modelDir = dir && *dir
                    ? QString::fromLocal8Bit(dir) : QStringLiteral("(未设置)");
                emit perfUpdate(QString(
                    "推理未运行：模型未就绪 RK3568_MODEL_DIR=%1 err=%2")
                    .arg(modelDir, QString::fromLocal8Bit(yolo_last_error())));
            }

            AsyncPlateResult asyncResult;
            if (plateWorker->latest(displayConfigVersion,
                                    pcieOverlayMaxAgeMs,
                                    asyncResult, plateDetResultAgeMs,
                                    pcieOverlayEffectiveMaxAgeMs)) {
                if (!asyncResult.error.isEmpty()) {
                    static int asyncInferErrWarn = 0;
                    if ((asyncInferErrWarn++ % 30) == 0) {
                        emit perfUpdate(QString("异步车牌推理异常: %1")
                                            .arg(asyncResult.error));
                    }
                } else {
                    applyOverlayPatches(fpgaMosaic,
                                        asyncResult.overlayPatches);
                    plateStagesMeasured =
                        (asyncResult.boxMs + asyncResult.ocrMs) > 0.1;
                    plateStageBoxMs = asyncResult.boxMs;
                    plateStageOcrMs = asyncResult.ocrMs;
                    plateDetRuntimeExecuted = asyncResult.executed;
                    plateDetPipelineEnabled = asyncResult.pipelineEnabled;
                    plateDetPipelineActive = asyncResult.pipelineActive;
                    plateDetQuantizedOutput = asyncResult.quantizedOutput;
                    plateDetTaskCount = asyncResult.taskCount;
                    lastDetScoreCandidates = asyncResult.scoreCandidates;
                    lastDetDecodedCandidates = asyncResult.decodedCandidates;
                    lastDetFinalCandidates = asyncResult.finalCandidates;
                    lastDetConfiguredStride = asyncResult.configuredStride;
                    lastDetSourceFrameSequence =
                        asyncResult.sourceFrameSequence;
                    lastDetDetectionSourceSequence =
                        asyncResult.lastDetectionSourceSequence;
                    plateDetPreMs = asyncResult.preMs;
                    plateDetNpuMs = asyncResult.npuWallMs;
                    plateDetNpuHwMs = asyncResult.npuHwMs;
                    plateDetPostMs = asyncResult.postMs;
                    plateDetE2eMs = asyncResult.e2eMs;
                    plateDetOverlapMs = asyncResult.overlapMs;
                    plateDetWorkerMs = asyncResult.workerMs;
                    plateDetOverlayMs = asyncResult.overlayMs;
                    plateDetStrategy = asyncResult.strategy;
                    plateDetPreprocessBackend =
                        asyncResult.preprocessBackend;
                    plateDetPreprocessRequested =
                        asyncResult.preprocessRequested;
                    plateDetPreprocessFallback =
                        asyncResult.preprocessFallback;
                    if (!firstAsyncPlateResultLogged) {
                        firstAsyncPlateResultLogged = true;
                        qInfo().noquote() << QString(
                            "RK_CAPTURE V1 first async inference completed "
                            "e2e=%1ms tasks=%2")
                            .arg(asyncResult.e2eMs, 0, 'f', 2)
                            .arg(asyncResult.taskCount);
                    }
                }
            }
            quint64 asyncCompletedCycles = 0;
            quint64 asyncCompletedTasks = 0;
            plateWorker->completionTotals(asyncCompletedCycles,
                                          asyncCompletedTasks);
            const inference_timing::CompletionDelta completionDelta =
                inference_timing::completionDelta(
                    asyncCompletedCycles, asyncCompletedTasks,
                    lastAsyncCompletedCycles, lastAsyncCompletedTasks);
            completedInferenceCycles += completionDelta.cycles;
            completedInferenceTasks += completionDelta.tasks;
            lastAsyncCompletedCycles = asyncCompletedCycles;
            lastAsyncCompletedTasks = asyncCompletedTasks;
            plateDetDroppedTasks = plateWorker->droppedTasks();
            plateDetQueueBusy = plateWorker->busy();

            const auto refreshStart = tick();
            if (mode == DisplayMode::FpgaMosaic) {
                img = fpgaMosaic;
                previewScaleBackend = QStringLiteral("zero_copy");
            } else {
                bool usedRga = false;
                composePciePreview(fpgaMosaic, mode, singleSource,
                                   mosaicMapping, m_viewBuf,
                                   captureRgaRequested, &usedRga);
                previewScaleBackend = usedRga
                    ? QStringLiteral("rga")
                    : (mode == DisplayMode::CustomMosaic
                           ? QStringLiteral("copy")
                           : QStringLiteral("opencv"));
                img = view;
            }
            postInferViewMs += ms(refreshStart, tick());
        } else {
            static int noModelWarn = 0;
            if (!yolo_is_ready()) {
                if ((noModelWarn++ % 30) == 0) {
                    const char* dir = std::getenv("RK3568_MODEL_DIR");
                    QString d = dir && *dir ? QString::fromLocal8Bit(dir) : QString("(未设置)");
                    emit perfUpdate(QString("推理未运行：模型未就绪 RK3568_MODEL_DIR=%1 err=%2")
                                        .arg(d, QString::fromLocal8Bit(yolo_last_error())));
                }
            }
            if (usePcie) {
                if (mode == DisplayMode::SingleSource) {
                    yolo_set_native_mosaic_layout(false, kSourceWidth,
                                                  kSourceHeight,
                                                  kActiveSourceMask);
                    cv::Mat sourceFrame = sourceRoi(fpgaMosaic, singleSource);
                    runPlateFrame(sourceFrame, singleSource, true);
                } else {
                    bool strategyOk = false;
                    const int requestedStrategy =
                        qgetenv("RK3568_PCIE_INFERENCE_STRATEGY")
                            .trimmed().toInt(&strategyOk);
                    const int pcieInferenceStrategy = strategyOk
                        ? std::clamp(requestedStrategy, 0, 1) : 0;
                    const bool perSourceFullInference =
                        pcieInferenceStrategy == 1;
                    unsigned int sourceMask = kActiveSourceMask;
                    if (mode == DisplayMode::CustomMosaic) {
                        sourceMask = 0u;
                        for (int source : mosaicMapping) {
                            if (source >= 1 && source <= 4) {
                                sourceMask |= 1u << (source - 1);
                            }
                        }
                    }
                    yolo_set_native_mosaic_layout(perSourceFullInference,
                                                  kSourceWidth,
                                                  kSourceHeight, sourceMask);
                    // PCIe uses either one full mosaic pass or one full pass
                    // per physical source. Fixed strip/sliding ROIs are never
                    // used for live four-source input.
                    // Inference runs on the physical FPGA layout. Custom GUI
                    // remapping happens only after detections are attributed.
                    yolo_set_view_context(
                        (int)DisplayMode::FpgaMosaic, 1, 1, 2, 3, 4);
                    runPlateFrame(fpgaMosaic, 1, false);
                    yolo_set_native_mosaic_layout(false, kSourceWidth,
                                                  kSourceHeight,
                                                  kActiveSourceMask);
                }
                const auto refreshStart = tick();
                if (mode == DisplayMode::FpgaMosaic) {
                    img = fpgaMosaic;
                    previewScaleBackend = QStringLiteral("zero_copy");
                } else {
                    bool usedRga = false;
                    composePciePreview(fpgaMosaic, mode, singleSource,
                                       mosaicMapping, m_viewBuf,
                                       captureRgaRequested, &usedRga);
                    previewScaleBackend = usedRga
                        ? QStringLiteral("rga")
                        : (mode == DisplayMode::CustomMosaic
                               ? QStringLiteral("copy")
                               : QStringLiteral("opencv"));
                    img = view;
                }
                postInferViewMs += ms(refreshStart, tick());
            } else if (useNativeSdQuadFrames) {
                std::array<bool, 4> processLane{false, false, false, false};
                if (mode == DisplayMode::SingleSource) {
                    processLane[static_cast<size_t>(std::max(0, std::min(3, singleSource - 1)))] = true;
                } else if (mode == DisplayMode::FpgaMosaic) {
                    processLane.fill(true);
                } else {
                    for (int source : mosaicMapping) {
                        if (source >= 1 && source <= 4) {
                            processLane[static_cast<size_t>(source - 1)] = true;
                        }
                    }
                }

                bool ranNativeLane = false;
                for (int lane = 0; lane < 4; ++lane) {
                    cv::Mat &nativeFrame = sdNativeQuadFrames[static_cast<size_t>(lane)];
                    if (!processLane[static_cast<size_t>(lane)] || nativeFrame.empty()) continue;
                    ranNativeLane = runPlateFrame(nativeFrame, lane + 1, true) || ranNativeLane;
                }

                if (ranNativeLane) {
                    composeAnnotatedSdDisplay(sdNativeQuadFrames, mode, singleSource,
                                              mosaicMapping, m_imageBuf888);
                    fpgaMosaic = cv::Mat(kPreviewHeight, kPreviewWidth,
                                         CV_8UC3, m_imageBuf888);
                    img = fpgaMosaic;
                } else {
                    runPlateFrame(img, singleSource, false);
                }
            } else {
                cv::Mat &plateFrame = useNativePlateFrame ? sdNativeFrame : img;
                runPlateFrame(plateFrame, singleSource, false);
                if (useNativePlateFrame) {
                    // Keep the UI at 1280x720 while preserving the native
                    // source for detection and OCR.
                    fitFrameToCanvas(sdNativeFrame, m_imageBuf888);
                    fpgaMosaic = cv::Mat(kPreviewHeight, kPreviewWidth,
                                         CV_8UC3, m_imageBuf888);
                    img = fpgaMosaic;
                }
            }
        }
        if (syncDetectionCycleCompleted) {
            ++completedInferenceCycles;
            completedInferenceTasks += syncDetectionTasksCompleted;
        }
        auto tDet1 = tick();
        auto tEnv0 = tick();
        double envAsyncWorkerMs = 0.0;
        int envStride = 1;
        if (const char* s = std::getenv("RK3568_ENV_INFER_STRIDE")) {
            int v = std::atoi(s);
            if (v > 0 && v <= 60) envStride = v;
        }
        // Use the same sequence namespace for the published frame and its
        // asynchronous detection result.  The old path tagged inference with
        // frameIdx while the Wi-Fi API tagged the image with the PCIe receive
        // sequence, which made an otherwise valid pair look unrelated to the
        // remote display computer.
        const quint64 apiSequence = usePcie
                                         ? pcieRxFrames
                                         : static_cast<quint64>(frameIdx);
        if (!globalInferenceEnabled || algoMode == AlgoMode::PlateOnly) {
            // done
        } else {
            if (globalInferenceEnabled && !startupPreviewOnly && envEnable != 0 &&
                (envStride <= 1 || (frameIdx % envStride) == 0)) {
                envWorker->trySubmit(img, mode != DisplayMode::SingleSource,
                                     apiSequence);
            }
        }
        AsyncEnvResult envResult;
        double envResultAgeMs = 0.0;
        // Keep the latest completed inference available to the Wi-Fi API even
        // when it is too old to paint over the moving preview. Overlay age is
        // a display policy; it must not turn a valid detection snapshot into
        // an HTTP 503 for the upper computer.
        if (envWorker->latest(0.0, envResult, envResultAgeMs)) {
            if (!envResult.error.isEmpty()) {
                static int envErrWarn = 0;
                if ((envErrWarn++ % 30) == 0) {
                    emit perfUpdate(QString("推理异常(环境): %1")
                                        .arg(envResult.error));
                }
            } else {
                if (envOverlayMaxAgeMs <= 0.0 ||
                    envResultAgeMs <= envOverlayMaxAgeMs) {
                    applyOverlayPatches(img, envResult.overlayPatches);
                }
                envAsyncWorkerMs = envResult.workerMs;
                QJsonObject detectionPayload;
                QJsonArray detectionArray;
                for (const GenericYoloDetection &det : envResult.detections) {
                    QJsonObject item;
                    item.insert("model_id", det.model_id);
                    item.insert("class_id", det.class_id);
                    item.insert("model", QString::fromStdString(det.model_key));
                    item.insert("class_name", QString::fromStdString(det.class_name));
                    item.insert("confidence", det.confidence);
                    item.insert("left", det.left);
                    item.insert("top", det.top);
                    item.insert("right", det.right);
                    item.insert("bottom", det.bottom);
                    detectionArray.append(item);
                }
                detectionPayload.insert("ok", true);
                detectionPayload.insert("frame_sequence",
                                        static_cast<double>(envResult.sourceFrameSequence));
                detectionPayload.insert("width", img.cols);
                detectionPayload.insert("height", img.rows);
                detectionPayload.insert("detections", detectionArray);
                QMutexLocker latestLock(&m_latestFrameMutex);
                m_latestDetections = detectionPayload;
            }
        }
        auto tEnv1 = tick();

        if (globalInferenceEnabled && envEnable != 0) {
            EnvViolationEvent vev;
            while (generic_yolo_pop_violation_event(vev)) {
                QTimeZone tz("Asia/Shanghai");
                QString time = QDateTime::currentDateTimeUtc().toTimeZone(tz).toString("yyyy-MM-dd HH:mm:ss");
                QByteArray jpeg((const char*)vev.jpeg.data(), (int)vev.jpeg.size());
                QByteArray thumb((const char*)vev.thumb_jpeg.data(), (int)vev.thumb_jpeg.size());
                int q0v = mosaicMapping[0], q1v = mosaicMapping[1], q2v = mosaicMapping[2], q3v = mosaicMapping[3];
                if (mode == DisplayMode::SingleSource) { q0v = singleSource; q1v = singleSource; q2v = singleSource; q3v = singleSource; }
                emit violationReport(jpeg, thumb, time, (int)mode, singleSource, q0v, q1v, q2v, q3v, (double)vev.overlap_iou);
            }
        } else if (!globalInferenceEnabled) {
            // Discard events queued before display-only mode was enabled.
            EnvViolationEvent discardedViolation;
            while (generic_yolo_pop_violation_event(discardedViolation)) {}
        }
        auto tInfer1 = tick();

        // Keep one immutable RGB snapshot for the Wi-Fi upper computer. The
        // capture loop remains the owner of DMA buffers; API readers only see
        // this detached copy and never touch the live frame.
        if (!img.empty() && img.type() == CV_8UC3) {
            cv::Mat apiRgb;
            cv::cvtColor(img, apiRgb, cv::COLOR_BGR2RGB);
            QImage apiImage(apiRgb.data, apiRgb.cols, apiRgb.rows,
                            static_cast<int>(apiRgb.step), QImage::Format_RGB888);
            QMutexLocker latestLock(&m_latestFrameMutex);
            m_latestMosaic = apiImage.copy();
            m_latestFrameSequence = apiSequence;
            m_latestFrameAt = QDateTime::currentDateTimeUtc();
        }

        // --- 4. UI 刷新逻辑 ---
        // Skip GUI conversion while an earlier frame is still queued. The
        // capture/inference/reporting path continues and always stays current.
        auto tUi0 = tick();
        if (displayConfigVersion == m_displayConfigVersion.load(
                std::memory_order_acquire) &&
            !m_frameDeliveryPending.exchange(true, std::memory_order_acq_rel)) {
            QImage out(img.cols, img.rows, QImage::Format_RGB888);
            bool guiConvertedWithRga = false;
#ifdef RK3568_HAVE_RGA
            if (captureRgaRequested && guiColorBackend != 0) {
                const bool converted = rgaBgrToRgb(img, out);
                double meanError = std::numeric_limits<double>::infinity();
                if (converted && guiColorBackend < 0) {
                    meanError = bgrRgbMeanError(img, out);
                }
                guiConvertedWithRga = converted &&
                    (guiColorBackend > 0 || meanError <= 1.0);
                if (guiConvertedWithRga) {
                    guiColorBackend = 1;
                    guiColorConvertBackend = QStringLiteral("rga");
                    if (std::isfinite(meanError)) {
                        qInfo().noquote() << QString(
                            "RK_CAPTURE GUI color backend=rga color_check_mae=%1")
                            .arg(meanError, 0, 'f', 2);
                    }
                } else {
                    guiColorBackend = 0;
                    guiColorConvertBackend = QStringLiteral("opencv");
                    qWarning().noquote() << QString(
                        "RK_CAPTURE GUI color RGA fallback reason=%1 color_check_mae=%2")
                        .arg(converted ? QStringLiteral("color_validation")
                                       : QStringLiteral("imcvtcolor_failed"))
                        .arg(std::isfinite(meanError)
                                 ? QString::number(meanError, 'f', 2)
                                 : QStringLiteral("n/a"));
                }
            }
#endif
            if (!guiConvertedWithRga) {
                cv::Mat showMat(out.height(), out.width(), CV_8UC3,
                                out.bits(), out.bytesPerLine());
                cv::cvtColor(img, showMat, cv::COLOR_BGR2RGB);
                guiColorConvertBackend = QStringLiteral("opencv");
            }
            if (!firstGuiColorBackendLogged) {
                firstGuiColorBackendLogged = true;
                qInfo().noquote() << QString(
                    "RK_CAPTURE GUI color backend=%1 deep_copy=0")
                    .arg(guiColorConvertBackend);
            }
            QPainter painter(&out);
            painter.setRenderHint(QPainter::TextAntialiasing);
            QFont font("WenQuanYi Zen Hei");
            font.setPixelSize(22);
            font.setBold(true);
            painter.setFont(font);
            painter.setPen(QColor(255, 255, 255));

            QTimeZone tz("Asia/Shanghai");
            QString nowStr = QDateTime::currentDateTimeUtc().toTimeZone(tz).toString("yyyy-MM-dd HH:mm:ss");
            painter.drawText(QRect(0, 0, out.width() - 12, 36), Qt::AlignRight | Qt::AlignVCenter, nowStr);

            auto drawTag = [&](int x, int y, const QString& text) {
                if (text.isEmpty()) return;
                QFontMetrics fm(font);
                int w = fm.horizontalAdvance(text) + 16;
                int h = 30;
                painter.fillRect(QRect(x, y, w, h), QColor(0, 0, 0, 140));
                painter.drawText(QRect(x + 8, y, w - 8, h), Qt::AlignVCenter | Qt::AlignLeft, text);
            };

            if (currentInputMode == InputMode::SdCard && !sdQuadMode) {
                drawTag(12, 8, "SD卡输入");
            } else if (mode == DisplayMode::SingleSource) {
                drawTag(12, 8, QString("输入源%1").arg(singleSource));
            } else {
                int w = out.width() / 2;
                int h = out.height() / 2;
                QString tl = mosaicMapping[0] > 0 ? QString("输入源%1").arg(mosaicMapping[0]) : QString();
                QString tr = mosaicMapping[1] > 0 ? QString("输入源%1").arg(mosaicMapping[1]) : QString();
                QString bl = mosaicMapping[2] > 0 ? QString("输入源%1").arg(mosaicMapping[2]) : QString();
                QString br = mosaicMapping[3] > 0 ? QString("输入源%1").arg(mosaicMapping[3]) : QString();
                drawTag(12, 8, tl);
                drawTag(w + 12, 8, tr);
                drawTag(12, h + 8, bl);
                drawTag(w + 12, h + 8, br);
            }
            painter.end();
            if (displayConfigVersion == m_displayConfigVersion.load(
                    std::memory_order_acquire)) {
                emit frameReady(out, displayConfigVersion);
                ++emittedDisplayFrames;
                if (usePcie && !firstGuiFrameLogged) {
                    firstGuiFrameLogged = true;
                    qInfo().noquote() << QString(
                        "RK_CAPTURE V1 first GUI frame emitted sequence=%1 config=%2 size=%3x%4")
                        .arg(pcieRxFrames).arg(displayConfigVersion)
                        .arg(out.width()).arg(out.height());
                    emit perfUpdate(QStringLiteral(
                        "PCIe V1 首帧已提交 GUI，采集链路正常。"));
                }
            } else {
                m_frameDeliveryPending.store(false, std::memory_order_release);
            }
        }
        auto tUi1 = tick();

        PlateReportEvent ev;
        // Plate worker results can finish after switching to environment-only
        // mode. Never publish those stale plate reports in that mode.
        if (globalInferenceEnabled && algoMode != AlgoMode::EnvOnly) {
            while (yolo_pop_report_event(ev)) {
                QString plate = QString::fromStdString(ev.plate_no);
                QString color = QString::fromUtf8(yolo_color_name(ev.color_idx));
                QTimeZone tz("Asia/Shanghai");
                QString time = QDateTime::currentDateTimeUtc().toTimeZone(tz).toString("yyyy-MM-dd HH:mm:ss");

                int reportSource = (currentInputMode == InputMode::SdCard && !sdQuadMode) ? 1 : ev.source_idx;
                emit plateReport(ev.thumb, plate, color, time, reportSource, (double)ev.conf, (double)ev.det_conf);
            }
        } else {
            // Drop any event already queued by an in-flight task.
            while (yolo_pop_report_event(ev)) {}
        }

        double capMs = usePcie
            ? std::max(0.0, pcieSample.dmaMs)
            : ms(tCap0, tCap1);
        double convMs = ms(tConv0, tConv1);
        double viewMs = ms(tView0, tView1) + postInferViewMs;
        double detTotalMs = ms(tDet0, tDet1);
        double envMs = envAsyncWorkerMs > 0.0
            ? envAsyncWorkerMs : ms(tEnv0, tEnv1);
        double detBoxMs = detTotalMs;
        double detOcrMs = 0.0;
        if (!globalInferenceEnabled) {
            detBoxMs = 0.0;
            detOcrMs = 0.0;
        } else if (algoMode != AlgoMode::EnvOnly) {
            if (plateStagesMeasured) {
                detBoxMs = plateStageBoxMs;
                detOcrMs = plateStageOcrMs;
            } else {
                detBoxMs = detTotalMs;
                detOcrMs = 0.0;
            }
        } else {
            detBoxMs = 0.0;
            detOcrMs = 0.0;
        }
        double inferMs = detBoxMs + detOcrMs + envMs;
        double uiMs = ms(tUi0, tUi1);
        // PCIe DMA runs in its own producer thread. Its duration overlaps the
        // consumer's conversion/view/UI work, so adding capMs here counts the
        // same wall-clock interval twice and understates the delivered FPS.
        double totalMs = usePcie
            ? ms(tCap0, tUi1)
            : capMs + convMs + viewMs + inferMs + uiMs;
        smooth(avgCapMs, capMs);
        smooth(avgConvMs, convMs);
        smooth(avgViewMs, viewMs);
        smooth(avgDetBoxMs, detBoxMs);
        smooth(avgDetOcrMs, detOcrMs);
        smooth(avgEnvMs, envMs);
        smooth(avgUiMs, uiMs);
        smooth(avgTotalMs, totalMs);
        if (plateDetRuntimeExecuted) {
            smooth(avgDetPreMs, plateDetPreMs);
            smooth(avgDetNpuWallMs, plateDetNpuMs);
            smooth(avgDetNpuHwMs, plateDetNpuHwMs);
            smooth(avgDetPostMs, plateDetPostMs);
            smooth(avgDetE2eMs, plateDetE2eMs);
            smooth(avgDetOverlapMs, plateDetOverlapMs);
            smooth(avgDetWorkerMs, plateDetWorkerMs);
            smooth(avgDetOverlayMs, plateDetOverlayMs);
            lastDetTaskCount = plateDetTaskCount;
            lastDetPipelineEnabled = plateDetPipelineEnabled;
            lastDetPipelineActive = plateDetPipelineActive;
            lastDetQuantizedOutput = plateDetQuantizedOutput;
            lastDetStrategy = plateDetStrategy;
            lastDetPreprocessBackend = plateDetPreprocessBackend;
            lastDetPreprocessRequested = plateDetPreprocessRequested;
            lastDetPreprocessFallback = plateDetPreprocessFallback;
        }
        if (!globalInferenceEnabled) {
            avgDetBoxMs = 0.0;
            avgDetOcrMs = 0.0;
            avgEnvMs = 0.0;
            avgDetPreMs = 0.0;
            avgDetNpuWallMs = 0.0;
            avgDetNpuHwMs = 0.0;
            avgDetPostMs = 0.0;
            avgDetE2eMs = 0.0;
            avgDetOverlapMs = 0.0;
            avgDetWorkerMs = 0.0;
            avgDetOverlayMs = 0.0;
            avgTotalMs = totalMs;
        }
        lastDetQueueBusy = plateDetQueueBusy;
        lastDetDroppedTasks = plateDetDroppedTasks;
        if (plateDetResultAgeMs > 0.0) {
            lastDetResultAgeMs = plateDetResultAgeMs;
        }

        auto now = std::chrono::high_resolution_clock::now();
        double dt = std::chrono::duration<double>(now - m_lastFrameTime).count();
        m_lastFrameTime = now;
        perfAccumSec += dt > 0 ? dt : 0.0;
        inferenceRateAccumSec += dt > 0 ? dt : 0.0;
        displayRateAccumSec += dt > 0 ? dt : 0.0;
        diagnosticLogAccumSec += dt > 0 ? dt : 0.0;
        if (perfAccumSec >= 0.5) {
            // This is the number of completed inference cycles observed in
            // the wall-clock reporting window. It is intentionally separate
            // from 1000/e2e_ms, which is only the model's single-run rate and
            // becomes misleading when capture, OCR, or async queueing overlap.
            if (!globalInferenceEnabled) {
                completedInferenceCycles = 0;
                completedInferenceTasks = 0;
                inferenceRateAccumSec = 0.0;
                publishedCycleFps = 0.0;
                publishedTaskFps = 0.0;
                publishedRateWindowSec = 0.0;
                inferenceRatePublished = true;
            } else if (inferenceRateAccumSec >= 1.5) {
                publishedCycleFps = static_cast<double>(
                    completedInferenceCycles) / inferenceRateAccumSec;
                publishedTaskFps = static_cast<double>(
                    completedInferenceTasks) / inferenceRateAccumSec;
                publishedRateWindowSec = inferenceRateAccumSec;
                inferenceRatePublished = true;
                completedInferenceCycles = 0;
                completedInferenceTasks = 0;
                inferenceRateAccumSec = 0.0;
            }
            const double actualCycleFps = !globalInferenceEnabled
                ? 0.0
                : (inferenceRatePublished
                    ? publishedCycleFps
                    : (inferenceRateAccumSec > 1e-6
                        ? static_cast<double>(completedInferenceCycles) /
                              inferenceRateAccumSec
                        : 0.0));
            const double actualTaskFps = !globalInferenceEnabled
                ? 0.0
                : (inferenceRatePublished
                    ? publishedTaskFps
                    : (inferenceRateAccumSec > 1e-6
                        ? static_cast<double>(completedInferenceTasks) /
                              inferenceRateAccumSec
                        : 0.0));
            const double actualRateWindowSec = inferenceRatePublished
                ? publishedRateWindowSec : inferenceRateAccumSec;
            if (displayRateAccumSec >= 1.0) {
                publishedDisplayFps = static_cast<double>(
                    emittedDisplayFrames) / displayRateAccumSec;
                publishedDisplayRateWindowSec = displayRateAccumSec;
                emittedDisplayFrames = 0;
                displayRateAccumSec = 0.0;
            }
            const double displayFps = publishedDisplayRateWindowSec > 0.0
                ? publishedDisplayFps
                : (displayRateAccumSec > 1e-6
                    ? static_cast<double>(emittedDisplayFrames) /
                          displayRateAccumSec
                    : 0.0);
            m_fps = actualCycleFps;
            emit fpsUpdate(m_fps);
            emit slidingStatus(false, 0, 0, 0);
            emit perfParts(avgCapMs, avgConvMs, avgViewMs, avgDetBoxMs, avgDetOcrMs,
                           avgEnvMs, avgUiMs, avgTotalMs, pcieRxFrames,
                           false, 0);
            QString base = QString("取帧/等待 %1ms  推理 %2ms  总计 %3ms | 框 %4  OCR %5  环境 %6  转换 %7  视图 %8  UI %9")
                .arg(avgCapMs, 0, 'f', 2)
                .arg((int)std::llround(avgDetBoxMs + avgDetOcrMs + avgEnvMs))
                .arg((int)std::llround(avgTotalMs))
                .arg((int)std::llround(avgDetBoxMs))
                .arg((int)std::llround(avgDetOcrMs))
                .arg((int)std::llround(avgEnvMs))
                .arg((int)std::llround(avgConvMs))
                .arg((int)std::llround(avgViewMs))
                .arg((int)std::llround(avgUiMs));
            base += QString("  infer_fps %1 det(score=%2 decoded=%3 final=%4)")
                .arg(actualCycleFps, 0, 'f', 2)
                .arg(lastDetScoreCandidates)
                .arg(lastDetDecodedCandidates)
                .arg(lastDetFinalCandidates);
            if (!globalInferenceEnabled) {
                base += QString("  display_only=1 display_fps=%1")
                    .arg(displayFps, 0, 'f', 2);
            }
            if (asyncPciePlate) {
                base += QString("  显示 %1fps")
                    .arg(displayFps, 0, 'f', 2);
            }
            if (usePcie) {
                const DriverCaptureMetrics capture = currentDriverCaptureMetrics();
                base += QString("  pcie(rx %1fps interval %2ms dma %3ms wait %4ms stage %5ms copy %6ms batch %7 drop %8)")
                    .arg(capture.actualRxFps, 0, 'f', 2)
                    .arg(capture.frameIntervalMs, 0, 'f', 2)
                    .arg(capture.dmaTransferMs, 0, 'f', 2)
                    .arg(capture.dmaWaitMs, 0, 'f', 2)
                    .arg(capture.kernelStagingMs, 0, 'f', 2)
                    .arg(capture.userCopyMs, 0, 'f', 2)
                    .arg(capture.batchIoctl ? 1 : 0)
                    .arg(capture.hostDroppedFrames);
                base += QString(" diag(source=0x%1 build=0x%2 debug=0x%3 fifo01=0x%4 fifo23=0x%5 handshake=0x%6)")
                    .arg(capture.sourceMask, 1, 16)
                    .arg(capture.fpgaBuildId, 8, 16, QLatin1Char('0'))
                    .arg(capture.fpgaDebugState, 8, 16, QLatin1Char('0'))
                    .arg(capture.fifoLevel01, 8, 16, QLatin1Char('0'))
                    .arg(capture.fifoLevel23, 8, 16, QLatin1Char('0'))
                    .arg(capture.fpgaHandshakeState, 8, 16, QLatin1Char('0'));
                base += QString(" infer_async(queue=%1 drop=%2 age=%3ms)")
                    .arg(lastDetQueueBusy ? 1 : 0)
                    .arg(lastDetDroppedTasks)
                    .arg(lastDetResultAgeMs, 0, 'f', 1)
                    + QString(" worker=%1ms overlay=%2ms")
                        .arg(avgDetWorkerMs, 0, 'f', 1)
                        .arg(avgDetOverlayMs, 0, 'f', 1);
                base += QString(" hw(convert=%1 preview=%2 gui_color=%3 render=%4)")
                    .arg(captureConvertBackend,
                         previewScaleBackend,
                         guiColorConvertBackend,
                         guiRenderPolicy);
            }
            emit perfDetParts(avgDetPreMs, avgDetNpuWallMs, avgDetPostMs);
            QJsonObject detRuntime;
            detRuntime.insert("executed",
                             globalInferenceEnabled && avgDetE2eMs > 1e-6);
            detRuntime.insert("inference_enabled", globalInferenceEnabled);
            detRuntime.insert("display_only", !globalInferenceEnabled);
            detRuntime.insert("capture_async", asyncPciePlate);
            detRuntime.insert("latest_only", asyncPciePlate);
            detRuntime.insert("overlay_max_age_ms",
                              pcieOverlayEffectiveMaxAgeMs);
            detRuntime.insert("overlay_configured_max_age_ms",
                              pcieOverlayMaxAgeMs);
            detRuntime.insert("display_cycle_ms", avgTotalMs);
            detRuntime.insert("display_fps", displayFps);
            detRuntime.insert("display_fps_basis", "frame_ready_emissions");
            detRuntime.insert("display_fps_window_ms",
                              publishedDisplayRateWindowSec * 1000.0);
            detRuntime.insert("capture_color_backend", captureConvertBackend);
            detRuntime.insert("capture_color_rga_dst_format",
                              rgb565RgaDestination);
            detRuntime.insert("preview_backend", previewScaleBackend);
            detRuntime.insert("gui_color_backend", guiColorConvertBackend);
            detRuntime.insert("capture_dropped_frames",
                static_cast<double>(currentDriverCaptureMetrics()
                                        .hostDroppedFrames));
            detRuntime.insert("strategy", lastDetStrategy);
            detRuntime.insert("pipeline_enabled", lastDetPipelineEnabled);
            detRuntime.insert("pipeline_active", lastDetPipelineActive);
            detRuntime.insert("quantized_output", lastDetQuantizedOutput);
            detRuntime.insert("preprocess_backend", lastDetPreprocessBackend);
            detRuntime.insert("preprocess_requested", lastDetPreprocessRequested);
            detRuntime.insert("preprocess_fallback_reason", lastDetPreprocessFallback);
            detRuntime.insert("task_count", lastDetTaskCount);
            detRuntime.insert("score_candidates", lastDetScoreCandidates);
            detRuntime.insert("decoded_candidates", lastDetDecodedCandidates);
            detRuntime.insert("final_candidates", lastDetFinalCandidates);
            detRuntime.insert("configured_stride", lastDetConfiguredStride);
            detRuntime.insert("source_frame_sequence",
                              static_cast<double>(lastDetSourceFrameSequence));
            detRuntime.insert("last_detection_source_sequence",
                              static_cast<double>(lastDetDetectionSourceSequence));
            detRuntime.insert("queue_depth", lastDetQueueBusy ? 1 : 0);
            detRuntime.insert("dropped_tasks",
                              static_cast<double>(lastDetDroppedTasks));
            detRuntime.insert("pre_ms", avgDetPreMs);
            detRuntime.insert("npu_wall_ms", avgDetNpuWallMs);
            detRuntime.insert("npu_hw_ms", avgDetNpuHwMs);
            detRuntime.insert("post_ms", avgDetPostMs);
            detRuntime.insert("e2e_ms", avgDetE2eMs);
            detRuntime.insert("overlap_saved_ms", avgDetOverlapMs);
            detRuntime.insert("worker_ms", avgDetWorkerMs);
            detRuntime.insert("overlay_ms", avgDetOverlayMs);
            detRuntime.insert("task_fps", actualTaskFps);
            detRuntime.insert("cycle_fps", actualCycleFps);
            detRuntime.insert("fps_basis", "completed_detection_cycles");
            detRuntime.insert("fps_window_ms", actualRateWindowSec * 1000.0);
            detRuntime.insert("result_age_ms", lastDetResultAgeMs);
            emit perfDetRuntime(detRuntime);
            if (qgetenv("RK3568_SHOW_DET_PARTS") == "1") {
                base += QString("  det_parts(pre %1 npu %2 post %3)")
                            .arg((int)std::llround(avgDetPreMs))
                            .arg((int)std::llround(avgDetNpuWallMs))
                            .arg((int)std::llround(avgDetPostMs));
            }
            emit perfUpdate(base);
            if (usePcie && diagnosticLogAccumSec >= 2.0) {
                qInfo().noquote() << "RK_CAPTURE" << base;
                diagnosticLogAccumSec = 0.0;
            }
            perfAccumSec = 0.0;
        }

        if (usePcie && pcieReadSlot >= 0 && pcieRing) {
            pcieRing->release(pcieReadSlot);
            pcieReadSlot = -1;
        }
        frameIdx++;
        if (!usePcie && captureSleepMs > 1.0) {
            unsigned long remainingMs = (unsigned long)std::llround(captureSleepMs);
            while (remainingMs > 0) {
                const unsigned long chunkMs = std::min<unsigned long>(remainingMs, 50);
                QThread::msleep(chunkMs);
                remainingMs -= chunkMs;
                QMutexLocker locker(&m_mutex);
                if (m_abort) break;
            }
        }
    }

    if (!usePcie) {
        QMutexLocker locker(&m_cfgMutex);
        m_sdResumePath = sdSourcePath;
        m_sdResumeImageIndex = std::max(0, sdMedia.imageIndex);
        m_sdResumeQuadImageIndex = sdMedia.quadImageIndex;
        for (int &idx : m_sdResumeQuadImageIndex) idx = std::max(0, idx);
        if (sdMedia.kind == SdMediaState::Kind::Video && sdMedia.video.isOpened()) {
            const double pos = sdMedia.video.get(cv::CAP_PROP_POS_FRAMES);
            m_sdResumeVideoFrame = std::max(0.0, pos);
        } else {
            m_sdResumeVideoFrame = 0.0;
        }
    }

    if (usePcie) {
        m_abortAtomic.store(true, std::memory_order_relaxed);
        if (pcieRing) pcieRing->stop();
        if (pcieDmaWorker.joinable()) pcieDmaWorker.join();
        if (plateWorker) plateWorker->stop();
    }
    if (dma_mapped) ioctl(m_fd, PCI_UMAP_ADDR_CMD, &dma_op);
    if (m_fd >= 0) {
        close(m_fd);
        m_fd = -1;
    }

    DriverCaptureMetrics finalMetrics = currentDriverCaptureMetrics();
    finalMetrics.running = false;
    finalMetrics.pcie = usePcie;
    finalMetrics.mode = usePcie
        ? QStringLiteral("v1-half-sampled") : captureMode;
    if (!captureError.isEmpty()) finalMetrics.lastError = captureError;
    updateDriverCaptureMetrics(finalMetrics);
    qInfo().noquote() << QString("RK_CAPTURE stopped mode=%1 frames=%2 error=%3")
        .arg(captureMode).arg(pcieRxFrames)
        .arg(captureError.isEmpty() ? QStringLiteral("none") : captureError);
    if (!captureError.isEmpty()) emit captureFailed(captureError);
}
