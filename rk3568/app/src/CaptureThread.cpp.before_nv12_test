class LatestPcieFrameRing {
public:
    enum class AcquireResult { Frame, Stopped, Error };

    LatestPcieFrameRing(int count, int frameBytes)
        : m_slots(static_cast<size_t>(count)) {
        for (Slot &slot : m_slots) {
            slot.bytes.resize(static_cast<size_t>(frameBytes));
        }
    }

    int beginWrite(const std::atomic_bool &stopRequested) {
        std::unique_lock<std::mutex> lock(m_mutex);
        for (;;) {
            if (m_stopped || stopRequested.load(std::memory_order_relaxed)) {
                return -1;
            }
            for (int i = 0; i < static_cast<int>(m_slots.size()); ++i) {
                if (m_slots[static_cast<size_t>(i)].state == SlotState::Free) {
                    m_slots[static_cast<size_t>(i)].state = SlotState::Writing;
                    return i;
                }
            }

            int oldestReady = -1;
            quint64 oldestSequence = std::numeric_limits<quint64>::max();
            for (int i = 0; i < static_cast<int>(m_slots.size()); ++i) {
                const Slot &slot = m_slots[static_cast<size_t>(i)];
                if (slot.state == SlotState::Ready &&
                    slot.sequence < oldestSequence) {
                    oldestReady = i;
                    oldestSequence = slot.sequence;
                }
            }
            if (oldestReady >= 0) {
                m_slots[static_cast<size_t>(oldestReady)].state =
                    SlotState::Writing;
                ++m_droppedFrames;
                return oldestReady;
            }
            m_freeCondition.wait_for(lock, std::chrono::milliseconds(10));
        }
    }

    uint8_t *data(int index) {
        if (index < 0 || index >= static_cast<int>(m_slots.size())) {
            return nullptr;
        }
        return m_slots[static_cast<size_t>(index)].bytes.data();
    }

    void publish(int index, quint64 sequence, const PcieFrameSample &sample) {
        std::lock_guard<std::mutex> lock(m_mutex);
        if (!validIndex(index)) return;
        Slot &slot = m_slots[static_cast<size_t>(index)];
        if (slot.state != SlotState::Writing) return;
        slot.sequence = sequence;
        slot.sample = sample;
        slot.state = SlotState::Ready;
        m_readyCondition.notify_one();
    }

    void failWrite(int index, const QString &error) {
        std::lock_guard<std::mutex> lock(m_mutex);
        if (validIndex(index) &&
            m_slots[static_cast<size_t>(index)].state == SlotState::Writing) {
            m_slots[static_cast<size_t>(index)].state = SlotState::Free;
        }
        m_error = error;
        m_stopped = true;
        m_readyCondition.notify_all();
        m_freeCondition.notify_all();
    }

    AcquireResult acquireLatest(const std::atomic_bool &stopRequested,
                                int &index, double &waitMs, QString &error) {
        const auto startedAt = std::chrono::steady_clock::now();
        std::unique_lock<std::mutex> lock(m_mutex);
        for (;;) {
            if (!m_error.isEmpty()) {
                error = m_error;
                return AcquireResult::Error;
            }
            if (m_stopped || stopRequested.load(std::memory_order_relaxed)) {
                return AcquireResult::Stopped;
            }

            int newest = -1;
            quint64 newestSequence = 0;
            for (int i = 0; i < static_cast<int>(m_slots.size()); ++i) {
                const Slot &slot = m_slots[static_cast<size_t>(i)];
                if (slot.state == SlotState::Ready &&
                    (newest < 0 || slot.sequence > newestSequence)) {
                    newest = i;
                    newestSequence = slot.sequence;
                }
            }
            if (newest >= 0) {
                for (int i = 0; i < static_cast<int>(m_slots.size()); ++i) {
                    if (i == newest) continue;
                    Slot &old = m_slots[static_cast<size_t>(i)];
                    if (old.state == SlotState::Ready) {
                        old.state = SlotState::Free;
                        ++m_droppedFrames;
                    }
                }
                m_freeCondition.notify_all();
                m_slots[static_cast<size_t>(newest)].state = SlotState::Reading;
                index = newest;
                waitMs = elapsedMs(startedAt, std::chrono::steady_clock::now());
                return AcquireResult::Frame;
            }
            m_readyCondition.wait_for(lock, std::chrono::milliseconds(10));
        }
    }

    PcieFrameSample sample(int index) const {
        std::lock_guard<std::mutex> lock(m_mutex);
        return validIndex(index)
            ? m_slots[static_cast<size_t>(index)].sample : PcieFrameSample{};
    }

    void release(int index) {
        std::lock_guard<std::mutex> lock(m_mutex);
        if (validIndex(index) &&
            m_slots[static_cast<size_t>(index)].state == SlotState::Reading) {
            m_slots[static_cast<size_t>(index)].state = SlotState::Free;
            m_freeCondition.notify_one();
        }
    }

    void stop() {
        std::lock_guard<std::mutex> lock(m_mutex);
        m_stopped = true;
        m_readyCondition.notify_all();
        m_freeCondition.notify_all();
    }

    quint64 droppedFrames() const {
        std::lock_guard<std::mutex> lock(m_mutex);
        return m_droppedFrames;
    }

private:
    enum class SlotState { Free, Writing, Ready, Reading };
    struct Slot {
        std::vector<uint8_t> bytes;
        SlotState state = SlotState::Free;
        quint64 sequence = 0;
        PcieFrameSample sample;
    };

    bool validIndex(int index) const {
        return index >= 0 && index < static_cast<int>(m_slots.size());
    }

    mutable std::mutex m_mutex;
    std::condition_variable m_readyCondition;
    std::condition_variable m_freeCondition;
    std::vector<Slot> m_slots;
    bool m_stopped = false;
    quint64 m_droppedFrames = 0;
    QString m_error;
};

