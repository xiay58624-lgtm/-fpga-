                                   MAP_SHARED, m_fd,
                                   static_cast<off_t>(offset));
            if (mapping == MAP_FAILED) {
                reason = systemError(QString("mmap V2 buffer %1").arg(index));
                m_mappings[static_cast<size_t>(index)] = nullptr;
                shutdown();
                return false;
            }
            m_mappings[static_cast<size_t>(index)] = mapping;
        }

        m_ready = true;
        m_fixed30FpsActive = true;
        m_sourceLocked = (start.status & PANGO_FRAME_STATUS_SOURCE_LOCKED) != 0u;
        m_recoveryState = m_sourceLocked
            ? QStringLiteral("running") : QStringLiteral("source-unlocked");
        return true;
    }

    DequeueResult dequeue(uint8_t *&data, PcieFrameSample &sample,
                          QString &error) {
        data = nullptr;
        sample = {};
        error.clear();
        if (!m_ready || m_fd < 0 || m_heldIndex >= 0) {
            error = QStringLiteral("V2 dequeue called in invalid state");
            return DequeueResult::Fatal;
        }

        pango_frame_dequeue_v2 dequeue{};
        dequeue.timeout_ms = 250;
        dequeue.flags = PANGO_FRAME_DQ_LATEST;
        const auto waitStart = std::chrono::steady_clock::now();
        if (ioctl(m_fd, PCI_FRAME_DQBUF_V2, &dequeue) != 0) {
            const int savedErrno = errno;
            if (savedErrno == EINTR || savedErrno == EAGAIN) {
                return DequeueResult::Retry;
            }
            if (savedErrno == ETIMEDOUT) {
                ++m_consecutiveTimeouts;
                pango_frame_stats_v2 stats{};
                const bool haveStats = ioctl(m_fd, PCI_FRAME_GET_STATS_V2, &stats) == 0;
                if (haveStats) {
                    updateStatsSnapshot(stats);
                    m_sourceLocked =
                        (stats.status & PANGO_FRAME_STATUS_SOURCE_LOCKED) != 0u;
                    if ((stats.status & PANGO_FRAME_STATUS_ERROR) != 0u ||
                        (stats.last_irq_status & PANGO_FRAME_IRQ_FATAL) != 0u) {
                        error = QString("V2 DMA/protocol error after timeout: status=0x%1 irq=0x%2 error=0x%3")
                            .arg(stats.status, 8, 16, QLatin1Char('0'))
                            .arg(stats.last_irq_status, 8, 16, QLatin1Char('0'))
                            .arg(stats.error_code, 8, 16, QLatin1Char('0'));
                        m_recoveryState = QStringLiteral("protocol-error");
                        return DequeueResult::Recover;
                    }
                    if (!m_sourceLocked) {
                        m_recoveryState = QStringLiteral("source-unlocked");
                        return DequeueResult::Retry;
                    }
                    if ((stats.status & PANGO_FRAME_STATUS_RING_FULL) != 0u) {
                        m_recoveryState = QStringLiteral("ring-full-nonfatal");
                        return DequeueResult::Retry;
                    }
                }
                if (m_consecutiveTimeouts < 3) {
                    m_recoveryState = QStringLiteral("timeout-retry");
                    return DequeueResult::Retry;
                }
                if (haveStats) {
                    error = QString("DQBUF_V2 timeout x%1: status=0x%2 free=0x%3 done=0x%4 writing=0x%5 source=0x%6 seq=%7 build=0x%8 debug=0x%9 fifo01=0x%10 fifo23=0x%11 handshake=0x%12")
                        .arg(m_consecutiveTimeouts)
                        .arg(stats.status, 8, 16, QLatin1Char('0'))
                        .arg(stats.free_bitmap, 1, 16)
                        .arg(stats.done_bitmap, 1, 16)
                        .arg(stats.writing_index, 8, 16, QLatin1Char('0'))
                        .arg(stats.source_valid_mask, 1, 16)
                        .arg(static_cast<qulonglong>(stats.producer_sequence))
                        .arg(stats.fpga_build_id, 8, 16, QLatin1Char('0'))
                        .arg(stats.fpga_debug_state, 8, 16, QLatin1Char('0'))
                        .arg(stats.fifo_level_01, 8, 16, QLatin1Char('0'))
                        .arg(stats.fifo_level_23, 8, 16, QLatin1Char('0'))
                        .arg(stats.fpga_handshake_state, 8, 16, QLatin1Char('0'));
                } else {
                    error = QString("DQBUF_V2 timeout x%1; GET_STATS_V2 failed")
                        .arg(m_consecutiveTimeouts);
                }
                m_recoveryState = QStringLiteral("timeout-recovery-required");
                return DequeueResult::Recover;
            }
            error = systemError(QStringLiteral("DQBUF_V2"), savedErrno);
            if (savedErrno == EPROTO) {
                // DQBUF has already removed and released metadata-invalid
                // buffers. Resetting the whole engine here creates a tight
                // STOP/RESET/CONFIG/START loop without making the next
                // metadata record any more valid.
                pango_frame_stats_v2 stats{};
                if (ioctl(m_fd, PCI_FRAME_GET_STATS_V2, &stats) == 0) {
                    updateStatsSnapshot(stats);
                    error = QString(
                        "V2 frame metadata rejected: errors=%1 status=0x%2 "
                        "irq=0x%3 fpga_error=0x%4 done=0x%5 source=0x%6 "
                        "seq=%7 build=0x%8 debug=0x%9 handshake=0x%10")
                        .arg(static_cast<qulonglong>(stats.protocol_errors))
                        .arg(stats.status, 8, 16, QLatin1Char('0'))
                        .arg(stats.last_irq_status, 8, 16, QLatin1Char('0'))
                        .arg(stats.error_code, 8, 16, QLatin1Char('0'))
                        .arg(stats.done_bitmap, 1, 16)
                        .arg(stats.source_valid_mask, 1, 16)
                        .arg(static_cast<qulonglong>(stats.producer_sequence))
                        .arg(stats.fpga_build_id, 8, 16, QLatin1Char('0'))
                        .arg(stats.fpga_debug_state, 8, 16, QLatin1Char('0'))
                        .arg(stats.fpga_handshake_state, 8, 16,
                             QLatin1Char('0'));
                }
                m_recoveryState = QStringLiteral("metadata-invalid");
                return DequeueResult::Retry;
            }
            if (savedErrno == EIO || savedErrno == EPIPE) {
                m_recoveryState = QStringLiteral("dma-recovery-required");
                return DequeueResult::Recover;
            }
            m_recoveryState = QStringLiteral("fatal");
            return DequeueResult::Fatal;
        }
        const auto dequeuedAt = std::chrono::steady_clock::now();

        const bool valid = dequeue.buffer_index <
                static_cast<quint32>(m_ringCount) &&
            (dequeue.output_flags & PANGO_FRAME_DQ_META_VALID) != 0u &&
            (dequeue.output_flags & PANGO_FRAME_DQ_TRUNCATED) == 0u &&
            dequeue.payload_bytes == static_cast<quint32>(kMosaicFrameBytes) &&
            dequeue.width == static_cast<quint32>(kMosaicWidth) &&
            dequeue.height == static_cast<quint32>(kMosaicHeight) &&
            dequeue.stride_bytes == static_cast<quint32>(kMosaicStrideBytes) &&
            dequeue.pixel_format == PANGO_FRAME_PIXEL_RGB565_LE &&
            dequeue.source_layout == PANGO_FRAME_LAYOUT_MOSAIC_2X2 &&
            validPcieSourceMask(dequeue.source_mask);
        if (!valid) {
            pango_frame_queue_v2 queue{};
            queue.buffer_index = dequeue.buffer_index;
            if (dequeue.buffer_index < static_cast<quint32>(m_ringCount)) {
                (void)ioctl(m_fd, PCI_FRAME_QBUF_V2, &queue);
            }
            error = QString("invalid V2 frame: flags=0x%1 index=%2 payload=%3 size=%4x%5 stride=%6 format=%7 layout=%8 source_mask=0x%9")
                .arg(dequeue.output_flags, 0, 16)
                .arg(dequeue.buffer_index)
                .arg(dequeue.payload_bytes)
                .arg(dequeue.width).arg(dequeue.height)
                .arg(dequeue.stride_bytes)
                .arg(dequeue.pixel_format)
                .arg(dequeue.source_layout)
                .arg(dequeue.source_mask, 0, 16);
            m_recoveryState = QStringLiteral("invalid-frame");
            return DequeueResult::Recover;
        }

        m_consecutiveTimeouts = 0;
        m_sourceLocked =
            (dequeue.status & PANGO_FRAME_STATUS_SOURCE_LOCKED) != 0u;
        m_sourceMask = dequeue.source_mask;
        m_recoveryState = m_sourceLocked
            ? QStringLiteral("running") : QStringLiteral("source-unlocked");

        const quint64 sequenceDelta = m_lastSequence > 0 &&
                dequeue.frame_seq > m_lastSequence
            ? dequeue.frame_seq - m_lastSequence : 1;
        double sourceIntervalMs = 0.0;
        if (m_lastTimestamp > 0 && dequeue.timestamp_ticks > m_lastTimestamp &&
            m_timestampHz > 0) {
            const quint64 tickDelta = dequeue.timestamp_ticks - m_lastTimestamp;
            sourceIntervalMs = 1000.0 * static_cast<double>(tickDelta) /
                static_cast<double>(m_timestampHz) /
                static_cast<double>(sequenceDelta);
        }
        if (sourceIntervalMs <= 0.0 &&
            m_lastDequeuedAt.time_since_epoch().count() != 0) {
            sourceIntervalMs = std::chrono::duration<double, std::milli>(
                dequeuedAt - m_lastDequeuedAt).count() /
                static_cast<double>(sequenceDelta);
        }
        if (m_lastSequence > 0 && sequenceDelta > 1) {
            m_hostSequenceGaps += sequenceDelta - 1;
        }
        m_lastSequence = dequeue.frame_seq;
        m_lastTimestamp = dequeue.timestamp_ticks;
        m_lastDequeuedAt = dequeuedAt;

        if ((++m_statsPollCounter % 15u) == 1u) {
            pango_frame_stats_v2 stats{};
            if (ioctl(m_fd, PCI_FRAME_GET_STATS_V2, &stats) == 0) {
                updateStatsSnapshot(stats);
            }
        }
        m_fpgaDroppedFrames = std::max<quint64>(
            m_fpgaDroppedFrames, dequeue.fpga_drop_count);

        m_heldIndex = static_cast<int>(dequeue.buffer_index);
        data = static_cast<uint8_t *>(
            m_mappings[static_cast<size_t>(m_heldIndex)]);
        sample.sequence = ++m_framesDelivered;
        sample.frameIntervalMs = sourceIntervalMs;
        // V2 exposes SOF timestamps but no DMA-complete timestamp. Keep DMA
        // duration unknown instead of misreporting the source frame interval.
        sample.dmaMs = 0.0;
        sample.waitMs = std::chrono::duration<double, std::milli>(
            dequeuedAt - waitStart).count();
        sample.batch = false;
        sample.irqWait = true;
        sample.stagedCopy = false;
        sample.frameV2 = true;
        sample.fpgaDroppedFrames = m_fpgaDroppedBase + m_fpgaDroppedFrames;
        sample.hostDroppedFrames = m_hostDroppedBase + m_hostDroppedFrames;
        sample.sequenceGaps = std::max(
            m_driverGapBase + m_driverSequenceGaps, m_hostSequenceGaps);
        return DequeueResult::Frame;
    }

    bool recover(QString &error) {
        error.clear();
        if (m_fd < 0 || !m_rateControlSupported) {
            error = QStringLiteral("V2 recovery requested without an active V2.1 session");
            m_recoveryState = QStringLiteral("recovery-unavailable");
            return false;
        }

        pango_frame_stats_v2 preRecoveryStats{};
        if (ioctl(m_fd, PCI_FRAME_GET_STATS_V2, &preRecoveryStats) == 0) {
            updateStatsSnapshot(preRecoveryStats);
        }

        ++m_recoveryCount;
        m_recoveryState = QStringLiteral("recovering");
        m_fixed30FpsActive = false;
        bool forcedResetAfterStopTimeout = false;
        if (m_heldIndex >= 0 && !release(error)) {
            m_recoveryState = QStringLiteral("recovery-qbuf-failed");
            return false;
        }

        pango_frame_stop_v2 stop{};
        stop.timeout_ms = 1000;
        if (m_started && ioctl(m_fd, PCI_FRAME_STOP_V2, &stop) != 0) {
            const int stopErrno = errno;
            if (stopErrno != ETIMEDOUT) {
                error = systemError(QStringLiteral("STOP_V2 recovery"),
                                    stopErrno);
                m_recoveryState = QStringLiteral("recovery-stop-failed");
                return false;
            }
            forcedResetAfterStopTimeout = true;
            m_recoveryState = QStringLiteral("recovery-force-reset");
        }
        m_started = false;

        pango_frame_reset_v2 reset{};
        reset.timeout_ms = 1000;
        if (ioctl(m_fd, PCI_FRAME_RESET_V2, &reset) != 0) {
            error = systemError(QStringLiteral("RESET_V2 recovery"));
            m_recoveryState = QStringLiteral("recovery-reset-failed");
            return false;
        }

        pango_frame_config_v2 config = m_config;
        config.target_fps_milli = PANGO_FRAME_V2_DEFAULT_FPS_MILLI;
        if (ioctl(m_fd, PCI_FRAME_CONFIG_V2, &config) != 0) {
            error = systemError(QStringLiteral("CONFIG_V2 recovery"));
            m_recoveryState = QStringLiteral("recovery-config-failed");
            return false;
        }
        if (config.target_fps_milli != PANGO_FRAME_V2_DEFAULT_FPS_MILLI ||
            config.buffer_capacity != m_bufferCapacity ||
            config.mmap_stride_bytes != m_mmapStride) {
            error = QString("V2 recovery config changed: fps=%1 capacity=%2 stride=%3")
                .arg(config.target_fps_milli)
                .arg(config.buffer_capacity)
                .arg(config.mmap_stride_bytes);
            m_recoveryState = QStringLiteral("recovery-config-mismatch");
            return false;
        }
        m_config = config;

        pango_frame_start_v2 start{};
        start.timeout_ms = 1000;
        if (ioctl(m_fd, PCI_FRAME_START_V2, &start) != 0) {
            error = systemError(QStringLiteral("START_V2 recovery"));
            m_recoveryState = QStringLiteral("recovery-start-failed");
            return false;
        }
        if (static_cast<int>(start.ring_count) != m_ringCount ||
            start.buffer_capacity != m_bufferCapacity ||
            start.mmap_stride_bytes != m_mmapStride ||
            (start.status & PANGO_FRAME_STATUS_RUNNING) == 0u ||
            (start.free_bitmap & ((1u << m_ringCount) - 1u)) == 0u) {
            error = QString("V2 recovery start invalid: ring=%1 capacity=%2 stride=%3 status=0x%4 free=0x%5")
                .arg(start.ring_count).arg(start.buffer_capacity)
                .arg(start.mmap_stride_bytes)
                .arg(start.status, 8, 16, QLatin1Char('0'))
                .arg(start.free_bitmap, 1, 16);
            m_recoveryState = QStringLiteral("recovery-mapping-mismatch");
            return false;
        }

        m_fpgaDroppedBase += m_fpgaDroppedFrames;
        m_hostDroppedBase += m_hostDroppedFrames;
        m_driverGapBase += m_driverSequenceGaps;
        m_protocolErrorBase += m_protocolErrors;
        m_fpgaDroppedFrames = 0;
        m_hostDroppedFrames = 0;
        m_driverSequenceGaps = 0;
        m_protocolErrors = 0;
        m_lastSequence = 0;
        m_lastTimestamp = 0;
        m_lastDequeuedAt = {};
        m_sourceMask = 0;
        m_statsPollCounter = 0;
        m_consecutiveTimeouts = 0;
        m_started = true;
        m_ready = true;
        m_fixed30FpsActive = true;
        m_sourceLocked =
            (start.status & PANGO_FRAME_STATUS_SOURCE_LOCKED) != 0u;
        if (forcedResetAfterStopTimeout) {
            m_recoveryState = m_sourceLocked
                ? QStringLiteral("running-after-forced-reset")
                : QStringLiteral("source-unlocked-after-forced-reset");
        } else {
            m_recoveryState = m_sourceLocked
                ? QStringLiteral("running-after-recovery")
                : QStringLiteral("source-unlocked");
        }
        return true;
    }

    void populateMetrics(DriverCaptureMetrics &metrics) const {
        metrics.protocol = protocolName();
        metrics.driverAbiVersion = m_driverAbiVersion;
        metrics.driverFeatures = m_driverFeatures;
        metrics.fpgaProtocolVersion = m_fpgaVersion;
        metrics.fpgaCapabilities = m_fpgaCapabilities;
        metrics.targetFpsMilli = PANGO_FRAME_V2_DEFAULT_FPS_MILLI;
        metrics.fpgaTargetFpsMilli = m_fpgaTargetFpsMilli;
        metrics.readBarBytes = m_readBarBytes;
        metrics.writeBarBytes = m_writeBarBytes;
        metrics.sourceMask = m_sourceMask;
        metrics.fpgaBuildId = m_fpgaBuildId;
        metrics.fpgaDebugState = m_fpgaDebugState;
        metrics.fifoLevel01 = m_fifoLevel01;
        metrics.fifoLevel23 = m_fifoLevel23;
        metrics.fpgaHandshakeState = m_fpgaHandshakeState;
        metrics.irqMode = m_irqMode;
        metrics.rateControlSupported = m_rateControlSupported;
        metrics.fixed30FpsActive = m_fixed30FpsActive;
        metrics.sourceLocked = m_sourceLocked;
        metrics.protocolErrors = m_protocolErrorBase + m_protocolErrors;
        metrics.recoveryCount = m_recoveryCount;
        metrics.consecutiveTimeouts = m_consecutiveTimeouts;
        metrics.recoveryState = m_recoveryState;
    }

    bool release(QString &error) {
        error.clear();
        if (m_heldIndex < 0) return true;
        pango_frame_queue_v2 queue{};
        queue.buffer_index = static_cast<quint32>(m_heldIndex);
        if (ioctl(m_fd, PCI_FRAME_QBUF_V2, &queue) != 0) {
            error = systemError(QStringLiteral("QBUF_V2"));
            return false;
        }
        m_heldIndex = -1;
        return true;
    }

    int ringCount() const { return m_ringCount; }

    void shutdown() {
        if (m_fd >= 0 && m_heldIndex >= 0) {
            pango_frame_queue_v2 queue{};
            queue.buffer_index = static_cast<quint32>(m_heldIndex);
            (void)ioctl(m_fd, PCI_FRAME_QBUF_V2, &queue);
            m_heldIndex = -1;
        }
        if (m_fd >= 0 && m_started) {
            pango_frame_stop_v2 stop{};
            stop.timeout_ms = 1000;
            (void)ioctl(m_fd, PCI_FRAME_STOP_V2, &stop);
        }
        for (void *mapping : m_mappings) {
            if (mapping) ::munmap(mapping, m_bufferCapacity);
        }
        m_mappings.clear();
        m_fd = -1;
        m_ready = false;
        m_started = false;
        m_ringCount = 0;
        m_bufferCapacity = 0;
        m_mmapStride = 0;
        m_timestampHz = 0;
        m_lastSequence = 0;
        m_lastTimestamp = 0;
        m_lastDequeuedAt = {};
        m_hostSequenceGaps = 0;
        m_hostDroppedFrames = 0;
        m_driverSequenceGaps = 0;
        m_protocolErrors = 0;
        m_fpgaDroppedFrames = 0;
        m_statsPollCounter = 0;
        m_driverAbiVersion = 0;
        m_driverFeatures = 0;
        m_fpgaVersion = 0;
        m_fpgaCapabilities = 0;
        m_fpgaTargetFpsMilli = 0;
        m_readBarBytes = 0;
        m_writeBarBytes = 0;
        m_sourceMask = 0;
        m_fpgaBuildId = 0;
        m_fpgaDebugState = 0;
        m_fifoLevel01 = 0;
        m_fifoLevel23 = 0;
        m_fpgaHandshakeState = 0;
        m_rateControlSupported = false;
        m_fixed30FpsActive = false;
        m_sourceLocked = false;
        m_consecutiveTimeouts = 0;
        m_recoveryCount = 0;
        m_framesDelivered = 0;
        m_fpgaDroppedBase = 0;
        m_hostDroppedBase = 0;
        m_driverGapBase = 0;
        m_protocolErrorBase = 0;
        m_irqMode.clear();
        m_recoveryState.clear();
    }

private:
    void updateStatsSnapshot(const pango_frame_stats_v2 &stats) {
        m_hostDroppedFrames = stats.host_dropped_frames;
        m_driverSequenceGaps = stats.sequence_gaps;
        m_fpgaDroppedFrames = stats.fpga_drop_count;
        m_protocolErrors = stats.protocol_errors;
        m_sourceMask = stats.source_valid_mask;
        m_fpgaBuildId = stats.fpga_build_id;
        m_fpgaDebugState = stats.fpga_debug_state;
        m_fifoLevel01 = stats.fifo_level_01;
        m_fifoLevel23 = stats.fifo_level_23;
        m_fpgaHandshakeState = stats.fpga_handshake_state;
    }

    static QString systemError(const QString &operation, int code = errno) {
        return QString("%1 errno=%2(%3)").arg(operation).arg(code)
            .arg(QString::fromLocal8Bit(strerror(code)));
    }

    QString protocolName() const {
        if (!m_fpgaVersion) return QStringLiteral("V2 unavailable");
        return QString("V%1.%2")
            .arg(m_fpgaVersion >> 16)
            .arg(m_fpgaVersion & 0xffffu);
    }

    int m_fd = -1;
    bool m_ready = false;
    bool m_started = false;
    int m_ringCount = 0;
    int m_heldIndex = -1;
    quint32 m_bufferCapacity = 0;
    quint32 m_mmapStride = 0;
    quint32 m_timestampHz = 0;
    pango_frame_config_v2 m_config{};
    std::vector<void *> m_mappings;
    quint64 m_lastSequence = 0;
    quint64 m_lastTimestamp = 0;
    std::chrono::steady_clock::time_point m_lastDequeuedAt;
    quint64 m_hostSequenceGaps = 0;
    quint64 m_hostDroppedFrames = 0;
    quint64 m_driverSequenceGaps = 0;
    quint64 m_protocolErrors = 0;
    quint64 m_fpgaDroppedFrames = 0;
    quint64 m_statsPollCounter = 0;
    quint32 m_driverAbiVersion = 0;
    quint32 m_driverFeatures = 0;
    quint32 m_fpgaVersion = 0;
    quint32 m_fpgaCapabilities = 0;
    quint32 m_fpgaTargetFpsMilli = 0;
    quint32 m_readBarBytes = 0;
    quint32 m_writeBarBytes = 0;
    quint32 m_sourceMask = 0;
    quint32 m_fpgaBuildId = 0;
    quint32 m_fpgaDebugState = 0;
    quint32 m_fifoLevel01 = 0;
    quint32 m_fifoLevel23 = 0;
