static double elapsedMs(const std::chrono::steady_clock::time_point &start,
                        const std::chrono::steady_clock::time_point &end) {
    return std::chrono::duration<double, std::milli>(end - start).count();
}

static QString dmaIoctlError(const char *name) {
    return QString("%1 errno=%2(%3)").arg(QString::fromLatin1(name))
        .arg(errno).arg(QString::fromLocal8Bit(strerror(errno)));
}

static bool readPcieFrameBatch(int fd, uint8_t *dst,
                               int unitBytes, int unitCount, int dmaSpin,
                               bool irqEnabled, PcieFrameSample &sample,
                               QString &error, bool &unsupported) {
    static_assert(sizeof(DMA_FRAME_V1_BATCH_OPERATION) == 48,
                  "V1 batch ioctl ABI size changed");
    unsupported = false;

    DMA_FRAME_V1_BATCH_OPERATION op{};
    op.current_len = static_cast<unsigned int>(unitBytes / 4);
    op.unit_count = static_cast<unsigned int>(unitCount);
    op.spin_count = static_cast<unsigned int>(dmaSpin);
    op.flags = irqEnabled ? PANGO_V1_BATCH_FLAG_WAIT_IRQ : 0u;
    op.user_ptr = static_cast<unsigned long long>(
        reinterpret_cast<uintptr_t>(dst));

    const auto frameStart = std::chrono::steady_clock::now();
    if (ioctl(fd, PCI_READ_FRAME_V1_BATCH_CMD, &op) != 0) {
        const int savedErrno = errno;
        unsupported = savedErrno == ENOTTY || savedErrno == EINVAL ||
                      savedErrno == ENOSYS;
        error = QString("READ_FRAME_V1_BATCH errno=%1(%2)")
            .arg(savedErrno)
            .arg(QString::fromLocal8Bit(strerror(savedErrno)));
        return false;
    }

    sample.dmaMs = elapsedMs(frameStart, std::chrono::steady_clock::now());
    sample.waitMs = static_cast<double>(op.wait_ns) / 1000000.0;
    sample.stagingMs = static_cast<double>(op.staging_ns) / 1000000.0;
    sample.copyMs = static_cast<double>(op.copy_ns) / 1000000.0;
    sample.batch = true;
    sample.irqWait = irqEnabled;
    sample.stagedCopy = true;
    return true;
}

static bool readPcieFrameLegacy(int fd, DMA_OPERATION &dmaOp, uint8_t *dst,
                                int unitBytes, int unitCount, int dmaSpin,
                                bool &irqEnabled, PcieFrameSample &sample,
                                QString &error, QString &irqFallbackReason,
                                const std::atomic_bool &stopRequested) {
    const auto frameStart = std::chrono::steady_clock::now();
    for (int i = 0; i < unitCount; ++i) {
        if (stopRequested.load(std::memory_order_relaxed)) {
            error = QStringLiteral("capture stopped");
            return false;
        }
        const auto waitStart = std::chrono::steady_clock::now();
        int writeRet = -1;
        if (irqEnabled) {
            writeRet = ioctl(fd, PCI_DMA_WRITE_WAIT_IRQ_CMD, &dmaOp);
            const int irqErrno = errno;
            const bool irqUnavailable = irqErrno == ETIMEDOUT || irqErrno == EINTR ||
                                        irqErrno == ENOTTY || irqErrno == EINVAL ||
                                        irqErrno == ENOSYS;
            if (writeRet != 0 && irqUnavailable) {
                if (irqFallbackReason.isEmpty()) {
                    irqFallbackReason = QString("WAIT_IRQ errno=%1(%2)")
                        .arg(irqErrno).arg(QString::fromLocal8Bit(strerror(irqErrno)));
                }
                irqEnabled = false;
                writeRet = ioctl(fd, PCI_DMA_WRITE_CMD, &dmaOp);
            }
        } else {
            writeRet = ioctl(fd, PCI_DMA_WRITE_CMD, &dmaOp);
        }
        if (writeRet != 0) {
            error = dmaIoctlError("DMA_WRITE");
            return false;
        }

        if (!irqEnabled && dmaSpin > 0) {
            for (volatile int k = 0; k < dmaSpin; ++k) {}
        }
        const auto waitEnd = std::chrono::steady_clock::now();
        sample.waitMs += elapsedMs(waitStart, waitEnd);

        DMA_PTR_OPERATION ptrOp{};
        ptrOp.current_len = static_cast<unsigned int>(unitBytes / 4);
        ptrOp.offset_addr = 0;
        ptrOp.user_ptr = static_cast<unsigned long long>(
            reinterpret_cast<uintptr_t>(dst + static_cast<size_t>(i) * unitBytes));

        const auto copyStart = std::chrono::steady_clock::now();
        if (ioctl(fd, PCI_READ_TO_USERPTR_CMD, &ptrOp) != 0) {
            if (ioctl(fd, PCI_READ_FROM_KERNEL_CMD, &dmaOp) != 0) {
                error = dmaIoctlError("DMA_READ");
                return false;
            }
            std::memcpy(dst + static_cast<size_t>(i) * unitBytes,
                        dmaOp.data.read_buf, static_cast<size_t>(unitBytes));
        }
        sample.copyMs += elapsedMs(copyStart, std::chrono::steady_clock::now());
    }
    sample.dmaMs = elapsedMs(frameStart, std::chrono::steady_clock::now());
    sample.batch = false;
    sample.irqWait = irqEnabled;
    return true;
}

static bool readPcieFrame(int fd, DMA_OPERATION &dmaOp, uint8_t *dst,
                          int unitBytes, int unitCount, int dmaSpin,
                          bool &batchEnabled, bool &irqEnabled,
                          PcieFrameSample &sample, QString &error,
                          QString &batchFallbackReason,
                          QString &irqFallbackReason,
                          const std::atomic_bool &stopRequested) {
    error.clear();
    if (batchEnabled) {
        bool unsupported = false;
        if (readPcieFrameBatch(fd, dst, unitBytes, unitCount, dmaSpin,
                               irqEnabled, sample, error, unsupported)) {
            return true;
        }
        if (!unsupported) return false;

        batchEnabled = false;
        if (batchFallbackReason.isEmpty()) batchFallbackReason = error;
        qWarning().noquote()
            << "RK_CAPTURE V1 batch ioctl unavailable; using legacy path:"
            << batchFallbackReason;
        error.clear();
    }

    return readPcieFrameLegacy(fd, dmaOp, dst, unitBytes, unitCount,
                               dmaSpin, irqEnabled, sample, error,
                               irqFallbackReason, stopRequested);
}

} // namespace

CaptureThread::CaptureThread(QObject *parent) 
    : QThread(parent),
      m_abort(false),
      m_fd(-1),
      m_imageBufTemp(nullptr),
      m_imageBuf888(nullptr),
      m_viewBuf(nullptr),
      m_fps(0.0),
      m_inputMode(InputMode::Pcie),
      m_sdImageIntervalSec(1),
      m_displayMode(DisplayMode::FpgaMosaic),
      m_singleSource(1),
      m_mosaicMapping{1, 2, 3, 4},
      m_algoMode(AlgoMode::PlateOnly),
      m_sdResumeImageIndex(0),
      m_sdResumeQuadImageIndex{0, 0, 0, 0},
      m_sdResumeVideoFrame(0.0) {
    // PCIe working buffers keep the native 2x2 mosaic. The GUI buffer is
    // deliberately 1280x720 so a 720p desktop never receives an 11 MB QImage.
    m_imageBufTemp = (uint8_t *)malloc(kMosaicFrameBytes);
    m_imageBuf888 = (uint8_t *)malloc(
        static_cast<size_t>(kMosaicWidth) * kMosaicHeight * 3);
    m_viewBuf = (uint8_t *)malloc(
        static_cast<size_t>(kPreviewWidth) * kPreviewHeight * 3);
    if (const QByteArray v = qgetenv("RK3568_SD_IMAGE_INTERVAL_SEC"); !v.isEmpty()) {
        bool ok = false;
        int x = v.toInt(&ok);
        if (ok) m_sdImageIntervalSec = std::max(1, std::min(5, x));
    }
}

CaptureThread::~CaptureThread() {
    stop();
    wait();
    if (m_imageBufTemp) free(m_imageBufTemp);
    if (m_imageBuf888) free(m_imageBuf888);
    if (m_viewBuf) free(m_viewBuf);
}

void CaptureThread::startCapture() {
    QMutexLocker locker(&m_mutex);
    m_abort = false;
    m_abortAtomic.store(false, std::memory_order_relaxed);
    m_frameDeliveryPending.store(false, std::memory_order_release);
    if (!isRunning()) start();
}

void CaptureThread::stop() {
    QMutexLocker locker(&m_mutex);
    m_abort = true;
    m_abortAtomic.store(true, std::memory_order_relaxed);
}

void CaptureThread::acknowledgeFrameDelivery() noexcept {
    m_frameDeliveryPending.store(false, std::memory_order_release);
}

bool CaptureThread::latestFrameJpeg(int source, QByteArray &jpeg,
                                    QJsonObject &metadata) const {
    jpeg.clear();
    metadata = QJsonObject();
    QImage frame;
    quint64 sequence = 0;
    QDateTime capturedAt;
    {
        QMutexLocker locker(&m_latestFrameMutex);
        if (m_latestMosaic.isNull()) return false;
        frame = m_latestMosaic;
        sequence = m_latestFrameSequence;
        capturedAt = m_latestFrameAt;
    }
    if (source < 0 || source > 4) return false;
    if (source > 0) {
        const int halfW = frame.width() / 2;
        const int halfH = frame.height() / 2;
        const int x = (source == 2 || source == 4) ? halfW : 0;
        const int y = (source >= 3) ? halfH : 0;
        frame = frame.copy(x, y, halfW, halfH);
    }
    QBuffer buffer(&jpeg);
    if (!buffer.open(QIODevice::WriteOnly) || !frame.save(&buffer, "JPG", 82)) {
        jpeg.clear();
        return false;
    }
    metadata.insert("ok", true);
    metadata.insert("source", source);
    metadata.insert("width", frame.width());
    metadata.insert("height", frame.height());
    metadata.insert("frame_sequence", static_cast<double>(sequence));
    if (capturedAt.isValid()) metadata.insert("captured_at", capturedAt.toString(Qt::ISODateWithMs));
    metadata.insert("content_type", "image/jpeg");
    return true;
}

bool CaptureThread::latestFrameRgb24(QImage &frame,
                                     QJsonObject &metadata) const {
    frame = QImage();
    metadata = QJsonObject();
    quint64 sequence = 0;
    QDateTime capturedAt;
    {
        QMutexLocker locker(&m_latestFrameMutex);
        if (m_latestMosaic.isNull()) return false;
        frame = m_latestMosaic;
        sequence = m_latestFrameSequence;
        capturedAt = m_latestFrameAt;
    }
    if (frame.isNull() || frame.format() != QImage::Format_RGB888 ||
        frame.bytesPerLine() != frame.width() * 3) {
        frame = QImage();
        return false;
    }
    metadata.insert("ok", true);
    metadata.insert("source", 0);
    metadata.insert("width", frame.width());
    metadata.insert("height", frame.height());
    metadata.insert("frame_sequence", static_cast<double>(sequence));
    if (capturedAt.isValid()) metadata.insert("captured_at", capturedAt.toString(Qt::ISODateWithMs));
    metadata.insert("content_type", "application/octet-stream");
    metadata.insert("pixel_format", "RGB24");
    return true;
}

bool CaptureThread::latestDetections(QJsonObject &payload) const {
    QMutexLocker locker(&m_latestFrameMutex);
    if (m_latestDetections.isEmpty()) return false;
    payload = m_latestDetections;
    return true;
}

void CaptureThread::setInputMode(InputMode mode) {
    QMutexLocker locker(&m_cfgMutex);
    if (m_inputMode != mode) {
        m_sdResumePath.clear();
        m_sdResumeImageIndex = 0;
        m_sdResumeQuadImageIndex = {0, 0, 0, 0};
        m_sdResumeVideoFrame = 0.0;
        m_displayConfigVersion.fetch_add(1, std::memory_order_acq_rel);
    }
    m_inputMode = mode;
}

void CaptureThread::setSdSourcePath(const QString &path) {
    QMutexLocker locker(&m_cfgMutex);
    const QString trimmed = path.trimmed();
    if (m_sdSourcePath != trimmed) {
        m_sdResumePath.clear();
        m_sdResumeImageIndex = 0;
        m_sdResumeQuadImageIndex = {0, 0, 0, 0};
        m_sdResumeVideoFrame = 0.0;
        m_displayConfigVersion.fetch_add(1, std::memory_order_acq_rel);
    }
    m_sdSourcePath = trimmed;
}

void CaptureThread::setSdImageIntervalSeconds(int seconds) {
    QMutexLocker locker(&m_cfgMutex);
    m_sdImageIntervalSec = std::max(1, std::min(5, seconds));
}

void CaptureThread::setDisplayMode(DisplayMode mode) {
    QMutexLocker locker(&m_cfgMutex);
    if (m_displayMode != mode) {
        m_displayConfigVersion.fetch_add(1, std::memory_order_acq_rel);
    }
    m_displayMode = mode;
}

void CaptureThread::setSingleSource(int sourceIndex) {
    QMutexLocker locker(&m_cfgMutex);
    if (sourceIndex < 1) sourceIndex = 1;
    if (sourceIndex > 4) sourceIndex = 4;
    if (m_singleSource != sourceIndex) {
        m_displayConfigVersion.fetch_add(1, std::memory_order_acq_rel);
    }
    m_singleSource = sourceIndex;
}

void CaptureThread::setMosaicMapping(const std::array<int, 4>& quadrantToSource) {
    QMutexLocker locker(&m_cfgMutex);
    const std::array<int, 4> previous = m_mosaicMapping;
    m_mosaicMapping = quadrantToSource;
    for (int i = 0; i < 4; ++i) {
        if (m_mosaicMapping[i] < 0) m_mosaicMapping[i] = 0;
        if (m_mosaicMapping[i] > 4) m_mosaicMapping[i] = 4;
    }
    if (m_mosaicMapping != previous) {
        m_displayConfigVersion.fetch_add(1, std::memory_order_acq_rel);
    }
}

void CaptureThread::setAlgoMode(AlgoMode mode) {
    QMutexLocker locker(&m_cfgMutex);
    if (m_algoMode != mode) {
        m_displayConfigVersion.fetch_add(1, std::memory_order_acq_rel);
    }
    m_algoMode = mode;
}

void CaptureThread::setGlobalInferenceEnabled(bool enabled) {
    const bool previous = m_globalInferenceEnabled.exchange(
        enabled, std::memory_order_acq_rel);
    if (previous != enabled) {
        // A frame rendered before the toggle must not be accepted after it.
        // This also makes an in-flight async result stale by generation.
        m_displayConfigVersion.fetch_add(1, std::memory_order_acq_rel);
    }
}

/**
 * @brief 优化后的 RGB565 转 RGB888
 * 对于嵌入式设备，尽量减少循环内的乘法运算
 */
void CaptureThread::rgb565_to_rgb888(const uint16_t *src, uint8_t *dst, int w, int h) {
    int pixels = w * h;
    for (int i = 0; i < pixels; ++i) {
        uint16_t p = src[i];
        // 提取并拉伸：5bit -> 8bit, 6bit -> 8bit
        *dst++ = (p & 0x1F) << 3;          // B
        *dst++ = ((p >> 5) & 0x3F) << 2;   // G
        *dst++ = ((p >> 11) & 0x1F) << 3;  // R
    }
}

void CaptureThread::run() {
    InputMode inputMode;
    QString sdSourcePath;
    {
        QMutexLocker locker(&m_cfgMutex);
        inputMode = m_inputMode;
        sdSourcePath = m_sdSourcePath;
    }

    bool usePcie = (inputMode == InputMode::Pcie);
    bool sdQuadMode = false;
    const QString captureMode = usePcie ? QStringLiteral("pcie") : QStringLiteral("sdcard");
    DriverCaptureMetrics initialMetrics;
    initialMetrics.running = true;
    initialMetrics.pcie = usePcie;
    initialMetrics.mode = captureMode;
    initialMetrics.v1FallbackAllowed = false;
    updateDriverCaptureMetrics(initialMetrics);

    const auto markCaptureStopped = [this, usePcie, captureMode](const QString &error) {
        DriverCaptureMetrics metrics = currentDriverCaptureMetrics();
        metrics.running = false;
        metrics.pcie = usePcie;
        metrics.mode = captureMode;
        if (!error.isEmpty()) metrics.lastError = error;
        updateDriverCaptureMetrics(metrics);
        if (!error.isEmpty()) emit captureFailed(error);
    };

    if (!m_imageBufTemp || !m_imageBuf888 || !m_viewBuf) {
        const QString error = QStringLiteral(
            "采集初始化失败: 1280x720 V1 帧缓冲内存分配失败");
        emit perfUpdate(error);
        markCaptureStopped(error);
        return;
    }

    // In the passive ADAS deployment the legacy plate/OCR stack is not part
    // of the pipeline. Avoid initializing its RKNN contexts altogether.
    const QByteArray displayOnlyEnv = qgetenv("RK3568_DISPLAY_ONLY").trimmed().toLower();
    const bool displayOnlyDeployment = displayOnlyEnv == "1" ||
        displayOnlyEnv == "true" || displayOnlyEnv == "yes" || displayOnlyEnv == "on";
    if (!displayOnlyDeployment) yolo_init();

    DMA_OPERATION dma_op{};
    bool dma_mapped = false;
    std::unique_ptr<LatestPcieFrameRing> pcieRing;
    std::thread pcieDmaWorker;
    std::unique_ptr<AsyncPlateWorker> plateWorker;
    std::unique_ptr<AsyncEnvWorker> envWorker =
        std::make_unique<AsyncEnvWorker>();
    SdMediaState sdMedia;
    m_lastFrameTime = std::chrono::high_resolution_clock::now();
    m_fps = 0.0;

    auto tick = []() { return std::chrono::steady_clock::now(); };
    auto ms = [](const std::chrono::steady_clock::time_point& a, const std::chrono::steady_clock::time_point& b) {
        return std::chrono::duration<double, std::milli>(b - a).count();
    };
    auto smooth = [](double &avg, double x) {
        if (avg <= 1e-6) avg = x;
        else avg = avg * 0.8 + x * 0.2;
    };

    double avgCapMs = 0.0, avgConvMs = 0.0, avgViewMs = 0.0, avgUiMs = 0.0, avgTotalMs = 0.0;
    double avgDetBoxMs = 0.0, avgDetOcrMs = 0.0, avgEnvMs = 0.0;
    double avgDetPreMs = 0.0, avgDetNpuWallMs = 0.0;
    double avgDetNpuHwMs = 0.0, avgDetPostMs = 0.0;
    double avgDetE2eMs = 0.0, avgDetOverlapMs = 0.0;
    double avgDetWorkerMs = 0.0, avgDetOverlayMs = 0.0;
    int lastDetTaskCount = 0;
    int lastDetScoreCandidates = 0;
    int lastDetDecodedCandidates = 0;
    int lastDetFinalCandidates = 0;
    int lastDetConfiguredStride = configuredPlateInferStride();
    quint64 lastDetSourceFrameSequence = 0;
    quint64 lastDetDetectionSourceSequence = 0;
    bool lastDetPipelineEnabled = false;
    bool lastDetPipelineActive = false;
    bool lastDetQuantizedOutput = false;
    bool lastDetQueueBusy = false;
    quint64 lastDetDroppedTasks = 0;
    double lastDetResultAgeMs = 0.0;
    QString lastDetStrategy = QStringLiteral("inactive");
    QString lastDetPreprocessBackend = QStringLiteral("opencv");
    QString lastDetPreprocessRequested = QStringLiteral("auto");
    QString lastDetPreprocessFallback;
    double perfAccumSec = 0.0;
    double diagnosticLogAccumSec = 0.0;
    quint64 appliedDisplayConfigVersion = 0;
    quint64 completedInferenceCycles = 0;
    quint64 completedInferenceTasks = 0;
    quint64 lastAsyncCompletedCycles = 0;
    quint64 lastAsyncCompletedTasks = 0;
    double inferenceRateAccumSec = 0.0;
    double publishedCycleFps = 0.0;
    double publishedTaskFps = 0.0;
    double publishedRateWindowSec = 0.0;
    bool inferenceRatePublished = false;
    quint64 emittedDisplayFrames = 0;
    double displayRateAccumSec = 0.0;
    double publishedDisplayFps = 0.0;
    double publishedDisplayRateWindowSec = 0.0;
    double envOverlayMaxAgeMs = 300.0;
    if (const char *s = std::getenv("RK3568_ENV_OVERLAY_MAX_AGE_MS")) {
        const int v = std::atoi(s);
        if (v >= 30 && v <= 2000) envOverlayMaxAgeMs = v;
    }

    const int frameBytes = kMosaicFrameBytes;
    int unitBytes = 2560;
    int unitCount = frameBytes / unitBytes;
    int dmaSpin = 2500;
    double v1TargetFps = kDefaultV1TargetFps;
    // The V1 FPGA protocol completes one DMA per image row. Waiting on every
    // row IRQ can generate about 21,600 wakeups/s at 30 FPS, so the known-good
    // bounded delay remains the production default.
    bool irqEnabled = false;
    QString irqFallbackReason = QStringLiteral("disabled by default for line-based DMA");
    bool batchEnabled = true;
    QString batchFallbackReason;
    if (usePcie) {
        m_fd = open(PCIE_DRIVER_FILE_PATH, O_RDWR);
        if (m_fd < 0) {
            const int openErrno = errno;
            const QString error = QString("采集失败: 无法打开 PCIe 设备 %1 errno=%2(%3)")
                .arg(PCIE_DRIVER_FILE_PATH).arg(openErrno).arg(QString::fromLocal8Bit(strerror(openErrno)));
            emit perfUpdate(error);
            markCaptureStopped(error);
            return;
        }

        if (const char* s = std::getenv("RK3568_DMA_SPIN")) {
            int v = std::atoi(s);
            if (v >= 0 && v <= 100000) dmaSpin = v;
        }
        if (const char* s = std::getenv("RK3568_DMA_WAIT_IRQ")) {
            const int mode = std::atoi(s);
            if (mode <= 0) {
                irqEnabled = false;
                irqFallbackReason = QStringLiteral("disabled by RK3568_DMA_WAIT_IRQ=0");
            } else {
                irqEnabled = true;
                irqFallbackReason.clear();
            }
        }
        if (const char* s = std::getenv("RK3568_V1_BATCH")) {
            if (std::atoi(s) == 0) {
                batchEnabled = false;
                batchFallbackReason = QStringLiteral(
                    "disabled by RK3568_V1_BATCH=0");
            }
        }
        if (const char* s = std::getenv("RK3568_DMA_UNIT_BYTES")) {
            int v = std::atoi(s);
            if (v > 0 && v <= 4096 && v % 4 == 0 && frameBytes % v == 0) {
                unitBytes = v;
                unitCount = frameBytes / unitBytes;
            }
        }
        if (const char* s = std::getenv("RK3568_V1_TARGET_FPS")) {
            char *end = nullptr;
            const double v = std::strtod(s, &end);
            if (end != s && v >= 1.0 && v <= 60.0) v1TargetFps = v;
        }
        emit perfUpdate(QString(
            "PCIe V1 已启用: 1280x720 RGB565 双路拼图，CAM1/CAM2 各 640x360，下排留黑，主机限速 %1 FPS")
            .arg(v1TargetFps, 0, 'f', 1));

        dma_op.current_len = (unsigned int)(unitBytes / 4);
        dma_op.offset_addr = 0;
        dma_mapped = (ioctl(m_fd, PCI_MAP_ADDR_CMD, &dma_op) == 0);
        if (!dma_mapped) {
            const int mapErrno = errno;
            const QString error = QString("采集失败: PCIe DMA MAP errno=%1(%2)")
                .arg(mapErrno).arg(QString::fromLocal8Bit(strerror(mapErrno)));
            emit perfUpdate(error);
            close(m_fd);
            m_fd = -1;
            markCaptureStopped(error);
            return;
        }

        DriverCaptureMetrics metrics;
        metrics.running = true;
        metrics.pcie = true;
        metrics.mode = QStringLiteral("v1-half-sampled");
        metrics.dmaUnitBytes = unitBytes;
        metrics.dmaUnitCount = unitCount;
        metrics.frameWidth = kMosaicWidth;
        metrics.frameHeight = kMosaicHeight;
        metrics.frameStrideBytes = kMosaicStrideBytes;
        metrics.frameBytes = kMosaicFrameBytes;
        metrics.ringCount = kPcieRingCount;
        metrics.batchIoctl = false;
        metrics.batchFallbackReason = batchFallbackReason;
        metrics.irqWait = irqEnabled;
        metrics.protocol = QStringLiteral("V1 half-sampled + batch-compatible");
        metrics.targetFpsMilli = static_cast<quint32>(
            std::llround(v1TargetFps * 1000.0));
        metrics.v1FallbackAllowed = false;
        metrics.v1FallbackActive = false;
        metrics.sourceMask = kActiveSourceMask;
        metrics.sourceLocked = true;
        metrics.rateControlSupported = false;
        metrics.fixed30FpsActive = false;
        updateDriverCaptureMetrics(metrics);

        qInfo().noquote() << QString(
            "RK_CAPTURE V1 DMA starting frame=1280x720 bytes=%1 unit=%2 count=%3 batch=%4")
            .arg(frameBytes).arg(unitBytes).arg(unitCount)
            .arg(batchEnabled ? 1 : 0);
        emit perfUpdate(QStringLiteral("PCIe V1 DMA 已启动，等待首个完整帧..."));

        pcieRing = std::make_unique<LatestPcieFrameRing>(
            kPcieRingCount, frameBytes);
        if (!displayOnlyDeployment) {
            plateWorker = std::make_unique<AsyncPlateWorker>();
        }
        pcieDmaWorker = std::thread([
            this, &dma_op, ring = pcieRing.get(), unitBytes, unitCount,
            dmaSpin, v1TargetFps, producerBatchEnabled = batchEnabled,
            producerBatchFallback = batchFallbackReason,
            producerIrqEnabled = irqEnabled,
            producerIrqFallback = irqFallbackReason]() mutable {
            quint64 sequence = 0;
            auto lastComplete = std::chrono::steady_clock::time_point{};
            const auto framePeriod = std::chrono::microseconds(
                static_cast<long long>(std::llround(
                    1000000.0 / v1TargetFps)));

            while (!m_abortAtomic.load(std::memory_order_relaxed)) {
                const auto frameStartedAt = std::chrono::steady_clock::now();
                const int slot = ring->beginWrite(m_abortAtomic);
                if (slot < 0) break;

                PcieFrameSample sample;
                QString error;
                if (!readPcieFrame(m_fd, dma_op, ring->data(slot),
                                   unitBytes, unitCount, dmaSpin,
                                   producerBatchEnabled, producerIrqEnabled,
                                   sample, error, producerBatchFallback,
                                   producerIrqFallback, m_abortAtomic)) {
                    if (m_abortAtomic.load(std::memory_order_relaxed)) {
                        ring->stop();
                    } else {
                        if (error.isEmpty()) {
                            error = QStringLiteral("PCIe frame DMA failed");
                        }
                        ring->failWrite(slot, error);
                    }
                    break;
                }

                ++sequence;
                sample.sequence = sequence;
                sample.batchFallbackReason = producerBatchFallback;
                sample.irqFallbackReason = producerIrqFallback;
                const auto completedAt = std::chrono::steady_clock::now();
                if (lastComplete.time_since_epoch().count() != 0) {
                    sample.frameIntervalMs = elapsedMs(lastComplete,
                                                       completedAt);
                }
                lastComplete = completedAt;
                sample.hostDroppedFrames = ring->droppedFrames();
                ring->publish(slot, sequence, sample);

                const auto deadline = frameStartedAt + framePeriod;
                while (!m_abortAtomic.load(std::memory_order_relaxed)) {
                    const auto now = std::chrono::steady_clock::now();
                    if (now >= deadline) break;
                    const auto remaining = std::chrono::duration_cast<
                        std::chrono::microseconds>(deadline - now);
                    std::this_thread::sleep_for(std::min(
                        remaining, std::chrono::microseconds(1000)));
                }
            }
            ring->stop();
        });
    } else {
        QString error;
        if (!prepareSdMedia(sdSourcePath, sdMedia, error)) {
            if (error.isEmpty()) error = QStringLiteral("SD 卡输入初始化失败");
            emit perfUpdate(error);
            markCaptureStopped(error);
            return;
        }
        {
            QMutexLocker locker(&m_cfgMutex);
            if (m_sdResumePath == sdSourcePath) {
                sdMedia.imageIndex = std::max(0, m_sdResumeImageIndex);
                sdMedia.quadImageIndex = m_sdResumeQuadImageIndex;
                for (int &idx : sdMedia.quadImageIndex) idx = std::max(0, idx);
                if (sdMedia.kind == SdMediaState::Kind::Video && sdMedia.video.isOpened() && m_sdResumeVideoFrame > 0.0) {
                    const double totalFrames = sdMedia.video.get(cv::CAP_PROP_FRAME_COUNT);
                    double pos = m_sdResumeVideoFrame;
                    if (totalFrames > 1.0) pos = std::min(pos, totalFrames - 1.0);
                    sdMedia.video.set(cv::CAP_PROP_POS_FRAMES, std::max(0.0, pos));
                }
            }
        }
    }

    int envEnable = 1;
    if (const char* s = std::getenv("RK3568_ENV_ENABLE")) envEnable = std::atoi(s);
    double pcieOverlayMaxAgeMs = 350.0;
    if (const char* s = std::getenv("RK3568_PCIE_OVERLAY_MAX_AGE_MS")) {
        char *end = nullptr;
        const double v = std::strtod(s, &end);
        if (end != s && v >= 50.0 && v <= 2000.0) {
            pcieOverlayMaxAgeMs = v;
        }
    }
