    detectorModelDetails->setVisible(false);
    recognizerModelRow->setVisible(false);
    recognizerModelDetails->setVisible(false);
    QLabel *modelSwitchHint = new QLabel(
        m_isCapturing
            ? "当前正在采集，请先停止采集后再切换模型。"
            : "当前页面显示环境检测模型；车牌 YOLOv5/OCR 配置仅保留给兼容模式。",
        modelTab);
