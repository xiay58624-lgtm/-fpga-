define_attribute {n:cmos1_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE} 
define_attribute {n:cmos2_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE} 
define_attribute {n:cmos3_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
define_attribute {n:cmos4_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
create_clock -name {cmos1_pclk} [get_ports {cmos1_pclk}] -period {11.900} -waveform {0.000 5.950}
create_clock -name {cmos2_pclk} [get_ports {cmos2_pclk}] -period {11.900} -waveform {0.000 5.950}
create_clock -name {cmos3_pclk} [get_ports {cmos3_pclk}] -period {11.900} -waveform {0.000 5.950}
create_clock -name {cmos4_pclk} [get_ports {cmos4_pclk}] -period {11.900} -waveform {0.000 5.950}
#create_generated_clock -name {cmos1_pclk_16bit} -source [get_ports {cmos1_pclk}] [get_pins {cmos1_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos1_pclk}] -multiply_by {1} -divide_by {2}
#create_generated_clock -name {cmos2_pclk_16bit} -source [get_ports {cmos2_pclk}] [get_pins {cmos2_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos2_pclk}] -multiply_by {1} -divide_by {2}
#set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk_16bit}]  -setup -hold
#set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk_16bit}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos3_pclk}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos4_pclk}]  -setup -hold
create_generated_clock -name {clk_10m} -source [get_ports {free_clk}] [get_nets {pll_inst.clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {2} -divide_by {5}
create_generated_clock -name {clk_25m} -source [get_ports {free_clk}] [get_nets {pll_inst.clkout1}] -master_clock [get_clocks {ref_clk}] -multiply_by {1} -divide_by {1}
create_generated_clock -name {clk_50m} -source [get_ports {free_clk}] [get_nets {pll_inst.clkout2}] -master_clock [get_clocks {ref_clk}] -multiply_by {2} -divide_by {1}
create_generated_clock -name {clk_75m} -source [get_ports {free_clk}] [get_nets {pll_inst.clkout3}] -master_clock [get_clocks {ref_clk}] -multiply_by {3} -divide_by {1}
create_generated_clock -name {pixclk_74p25m} -source [get_ports {free_clk}] [get_pins {vpll_inst/u_gpll.CLKOUT0}] -master_clock [get_clocks {ref_clk}] -edges {1 2 3} -edge_shift {0.000000 -13.265993 -26.531987} -add
create_generated_clock -name {cmos1_pclk_16bit} -source [get_ports {cmos1_pclk}] [get_pins {cmos1_8_16bit/u_GTP_IOCLKDIV.CLKDIVOUT}] -master_clock [get_clocks {cmos1_pclk}] -edges {1 2 3} -edge_shift {0.000000 5.950000 11.900000} -add
create_generated_clock -name {cmos2_pclk_16bit} -source [get_ports {cmos2_pclk}] [get_pins {cmos2_8_16bit/u_GTP_IOCLKDIV.CLKDIVOUT}] -master_clock [get_clocks {cmos2_pclk}] -edges {1 2 3} -edge_shift {0.000000 5.950000 11.900000} -add
create_generated_clock -name {cmos3_pclk_16bit} -source [get_ports {cmos3_pclk}] [get_pins {cmos2_8_16bit_fmc/u_GTP_IOCLKDIV.CLKDIVOUT}] -master_clock [get_clocks {cmos3_pclk}] -edges {1 2 3} -edge_shift {0.000000 5.950000 11.900000} -add
create_generated_clock -name {cmos4_pclk_16bit} -source [get_ports {cmos4_pclk}] [get_pins {cmos4_8_16bit_fmc/u_GTP_IOCLKDIV.CLKDIVOUT}] -master_clock [get_clocks {cmos4_pclk}] -edges {1 2 3} -edge_shift {0.000000 5.950000 11.900000} -add
create_clock -name {cmos1_i2c_clk} [get_nets {coms1_reg_config/clock_20k}] -period {50000.000} -waveform {0.000 25000.000}
create_clock -name {cmos2_i2c_clk} [get_nets {coms2_reg_config/clock_20k}] -period {50000.000} -waveform {0.000 25000.000}
create_clock -name {cmos3_i2c_clk} [get_nets {coms3_reg_config/clock_20k}] -period {50000.000} -waveform {0.000 25000.000}
create_clock -name {cmos4_i2c_clk} [get_nets {coms4_reg_config/clock_20k}] -period {50000.000} -waveform {0.000 25000.000}
# ????????? (?????? 0.200ns)
set_clock_uncertainty 0.200 [get_clocks {cmos1_pclk}] -setup -hold
set_clock_uncertainty 0.200 [get_clocks {cmos2_pclk}] -setup -hold
set_clock_uncertainty 0.200 [get_clocks {cmos3_pclk}] -setup -hold
set_clock_uncertainty 0.200 [get_clocks {cmos4_pclk}] -setup -hold
# ?????? DDR / PCIe ???????????????????????????
set_clock_groups -asynchronous -group [get_clocks {cmos1_pclk}]
set_clock_groups -asynchronous -group [get_clocks {cmos2_pclk}]
set_clock_groups -asynchronous -group [get_clocks {cmos3_pclk}]
set_clock_groups -asynchronous -group [get_clocks {cmos4_pclk}]

# CDC clock groups for video-write and control domains.
# Define the generated video clocks explicitly before grouping; otherwise Pango
# infers them later and early set_clock_groups can miss the clocks in timing.
set_clock_groups -name {fpga2_cmos1_16bit_async} -asynchronous -group [get_clocks {cmos1_pclk_16bit}]
set_clock_groups -name {fpga2_cmos2_16bit_async} -asynchronous -group [get_clocks {cmos2_pclk_16bit}]
set_clock_groups -name {fpga2_cmos3_16bit_async} -asynchronous -group [get_clocks {cmos3_pclk_16bit}]
set_clock_groups -name {fpga2_cmos4_16bit_async} -asynchronous -group [get_clocks {cmos4_pclk_16bit}]
set_clock_groups -name {fpga2_sfp_pix_async} -asynchronous -group [get_clocks {pixclk_74p25m}]
set_clock_groups -name {fpga2_cfg50_async} -asynchronous -group [get_clocks {clk_50m}]
set_clock_groups -name {fpga2_ctrl75_async} -asynchronous -group [get_clocks {clk_75m}]



