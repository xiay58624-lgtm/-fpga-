[Unit]
Description=ADAS Upper Computer Web Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adas-upper/html/backend
EnvironmentFile=/etc/adas-upper.env
ExecStart=/usr/bin/node /opt/adas-upper/html/backend/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/adas-upper/html/backend/uploads /opt/adas-upper/html/backend

[Install]
WantedBy=multi-user.target
